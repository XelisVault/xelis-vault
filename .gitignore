# ============================================================================
# .gitignore — XELIS Vault v13
# ============================================================================

# Secrets & environment
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build-pkg/
.pytest_cache/
.venv/
venv/

# CI artifacts
reports/

# Bearer notes — NEVER commit a mixer note
note*.json
notes/
*.note.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Binaries (download them from official releases)
*.exe
bin/xelis_wallet
bin/xelis_daemon

# Never track legacy build artifacts larger than what git can bear
legacy/build/*.bin
