// Set the annual stability fee rate (in bps) applied to outstanding borrows.
// @caller: admin (or timelock via contract call)
// @params: bps - annual rate in bps (max 5000 = 50% APR)
// @returns: 0 on success
// @security: only_admin, range-checked, accrues pending fees before changing rate
// ID 21: set_stability_fee_bps  (FIX #9: configurable)
entry set_stability_fee_bps(bps: u64) -> u64 {
    only_admin()
    require(bps <= 5000, "badval")  // max 50% APR
    update_stability_fee_index()
    Storage::new().store(STABILITY_FEE_BPS_KEY, bps)
    return 0
}

