    Storage::new().store(TOTAL_BUDGET_KEY, amount)
    return 0
}

// ID 24: set_target_duration
// Update the target distribution window (in blocks) used by maybe_adjust_budget to pace emissions.
// @caller: admin (or timelock as contract caller)
