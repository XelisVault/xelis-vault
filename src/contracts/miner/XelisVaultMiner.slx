// ============================================================================
// XelisVaultMiner.slx — XELIS Vault v5.1
// ----------------------------------------------------------------------------
// Silex-verified, all entry IDs aligned, all bugs from audit v4.3 fixed.
// v5.1: documentation-only minor bump (rich doc comments on every entry & pub fn).
// ============================================================================
const VERSION: string = "XelisVaultMiner v11.3"

const ADMIN_KEY: string = "a"
const TIMELOCK_KEY: string = "tl"
const GUARDIAN_KEY: string = "gd"
const EMERGENCY_KEY: string = "ea"
const PAUSED_KEY: string = "pz"
const REGISTRY_KEY: string = "reg"
const VLT_CONTRACT_KEY: string = "vc"
const VLT_ASSET_KEY: string = "va"
const DELEGATION_CONTRACT_KEY: string = "dck"  // v11.0: MinerDelegation contract hash (for pushing own_stake updates)
const TREASURY_KEY: string = "tr"

const MIN_STAKE_KEY: string = "ms"
const HEARTBEAT_INTERVAL_KEY: string = "hi"
const HEARTBEAT_TIMEOUT_KEY: string = "ht"

const TOTAL_BUDGET_KEY: string = "tb"
const DISTRIBUTED_KEY: string = "dist"
const LAUNCH_TOPO_KEY: string = "lt"
const TARGET_DURATION_BLOCKS_KEY: string = "td"
const BUDGET_FACTOR_KEY: string = "bf"
const LAST_BUDGET_ADJUST_KEY: string = "lba"
const BUDGET_ADJUST_INTERVAL_KEY: string = "bai"

const BASE_REWARD_ORACLE_KEY: string = "bro"
const BASE_REWARD_CHAT_KEY: string = "brc"

const SERVICE_PREFIX: string = "svc_"

const MINERS_COUNT_KEY: string = "mc"
const MINER_PREFIX: string = "miner_"
const MINER_LIST_PREFIX: string = "ml_"
const SERVICE_MINERS_PREFIX: string = "sm_"
const TOTAL_STAKED_KEY: string = "ts"

const DEFAULT_MIN_STAKE: u64 = 100000000000          // 1000 VLT (v10.7: was 100, 10x anti-Sybil)
const DEFAULT_HEARTBEAT_INTERVAL: u64 = 100
const DEFAULT_HEARTBEAT_TIMEOUT: u64 = 300

const DEFAULT_TOTAL_BUDGET: u64 = 550000000000000    // 5.5M VLT (v10.7: was 6M, match whitepaper)
const DEFAULT_TARGET_DURATION: u64 = 63072000
const DEFAULT_BUDGET_FACTOR: u64 = 10000             // 1.0x (v10.10: budget_factor kept for compat but unused — rewards are now stake-weighted)
const DEFAULT_BUDGET_ADJUST_INTERVAL: u64 = 2016      // 2 weeks (kept for compat, maybe_adjust_budget is now no-op)

const DEFAULT_BASE_REWARD_ORACLE: u64 = 1000000       // 0.01 VLT (v10.8: stake-weighted, no daily cap)
const DEFAULT_BASE_REWARD_CHAT: u64 = 10000000        // 0.1 VLT (v10.7: was 0.5, 5x reduction)

// v10.8: Stake-weighted rewards (replaces daily cap)
// More stake = more rewards (linear, capped at MAX_STAKE_MULTIPLIER)
// No Sybil advantage: 10 miners × 1000 VLT = 1 miner × 10000 VLT (same total)
const MAX_STAKE_MULTIPLIER: u64 = 50                   // max 50x reward for 50,000+ VLT stake

// v10.11: Bitcoin-style halving rewards (replaces fixed daily budget)
// Rewards halve every year, lasting 30+ years with decreasing emission
// Geometric series: initial + initial/2 + initial/4 + ... = 2 × initial
// Initial year distributes 2,750,000 VLT → total approaches 5,500,000 VLT
const HALVING_INTERVAL_BLOCKS: u64 = 6307200              // 1 year at 5s blocks
const INITIAL_REWARD_PER_BLOCK: u64 = 43593000            // ~0.436 VLT/block (2,750,000 VLT / 6,307,200 blocks)

// v11.0: STAKE_FLOOR — virtual minimum total stake in denominator
// Prevents explosive APY when few miners are active
// Without this: 3 miners × 1,000 VLT = 3,000 total → 90,000% APY
// With STAKE_FLOOR = 100,000 VLT: APY bounded to ~2,750% even with 3 miners
// As real stake grows past 100,000, the floor is no longer relevant
const STAKE_FLOOR: u64 = 10000000000000               // 100,000 VLT virtual floor
const CAP_STAKE_PER_MINER: u64 = 50000000000000       // 500,000 VLT max stake counted per miner

const REP_MAX: u64 = 10000
const REP_EXCELLENT: u64 = 8000
const REP_GOOD: u64 = 5000
const REP_WARNING: u64 = 2000
const REP_CRITICAL: u64 = 1000
const REP_BANNED: u64 = 0

// v11.4: New miners start at REP_START (between Warning and Good)
// They must prove themselves over time to reach Good then Excellent
const REP_START: u64 = 3000              // Start at 3000 (between Warning=2000 and Good=5000)
// v11.4: Reputation gain per valid submission (slower growth = must prove over time)
const REP_GAIN_PRICE: u64 = 1            // +1 per valid price submission (was 1, keep)
const REP_GAIN_ANCHOR: u64 = 3           // +3 per valid anchor (was 5, slower)
const REP_GAIN_HEARTBEAT: u64 = 1         // +1 per heartbeat (was 1, keep)
// Time-based reputation: after N blocks active, get a bonus
const REP_PROVEN_BLOCKS: u64 = 259200    // 15 days at 5s blocks (proven miner)

const REP_LOSS_OUTLIER: u64 = 50
const REP_LOSS_OFFLINE: u64 = 200
const REP_LOSS_DATA_LOSS: u64 = 500
const REP_LOSS_CENSORSHIP: u64 = 1000
const REP_LOSS_MALICIOUS: u64 = 5000

struct Miner {
    addr: Address,
    endpoint_url: string,
    miner_pubkey: Hash,
    stake: u64,
    services_mask: u8,
    registered_at: u64,
    last_heartbeat: u64,
    total_rewards_earned: u64,
    total_slashed: u64,
    reputation: u64,
    valid_submissions: u64,
    successful_anchors: u64,
    total_submissions: u64,
    last_infraction_topo: u64,
    active: bool
}

hook constructor() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    s.store(ADMIN_KEY, caller)
    s.store(GUARDIAN_KEY, caller)
    s.store(EMERGENCY_KEY, caller)
    s.store(PAUSED_KEY, false)
    s.store(MINERS_COUNT_KEY, 0u64)
    s.store(TOTAL_STAKED_KEY, 0u64)
    s.store(MIN_STAKE_KEY, DEFAULT_MIN_STAKE)
    s.store(HEARTBEAT_INTERVAL_KEY, DEFAULT_HEARTBEAT_INTERVAL)
    s.store(HEARTBEAT_TIMEOUT_KEY, DEFAULT_HEARTBEAT_TIMEOUT)
    s.store(TOTAL_BUDGET_KEY, DEFAULT_TOTAL_BUDGET)
    s.store(DISTRIBUTED_KEY, 0u64)
    s.store(LAUNCH_TOPO_KEY, get_current_topoheight())
    s.store(TARGET_DURATION_BLOCKS_KEY, DEFAULT_TARGET_DURATION)
    s.store(BUDGET_FACTOR_KEY, DEFAULT_BUDGET_FACTOR)
    s.store(LAST_BUDGET_ADJUST_KEY, get_current_topoheight())
    s.store(BUDGET_ADJUST_INTERVAL_KEY, DEFAULT_BUDGET_ADJUST_INTERVAL)
    s.store(BASE_REWARD_ORACLE_KEY, DEFAULT_BASE_REWARD_ORACLE)
    s.store(BASE_REWARD_CHAT_KEY, DEFAULT_BASE_REWARD_CHAT)
    return 0
}

fn only_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let admin: Address = s.load(ADMIN_KEY).expect("err")
    if caller == admin { return }
    let tl_opt: optional<Hash> = s.load(TIMELOCK_KEY)
    require(tl_opt.is_some(), "notauth")
    let tl: Hash = tl_opt.expect("err")
    let cc: Hash = get_contract_caller().expect("err")
    require(cc == tl, "notauth")
}

fn only_guardian_or_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let g: Address = s.load(GUARDIAN_KEY).expect("err")
    if caller == g { return }
    only_admin()
}

fn only_authorized_service() {
    let s: Storage = Storage::new()
    let cc_opt: optional<Hash> = get_contract_caller()
    require(cc_opt.is_some(), "noservice")
    let cc: Hash = cc_opt.expect("err")
    let service_id: u8 = s.load(SERVICE_PREFIX + cc.to_hex()).unwrap_or(0)
    require(service_id > 0, "notauth")
}

fn when_not_paused() {
    let paused: bool = Storage::new().load(PAUSED_KEY).unwrap_or(false)
    require(!paused, "paused")
}

fn get_reputation_multiplier(rep: u64) -> u64 {
    if rep >= REP_EXCELLENT { return 15000 }  // 1.5x
    if rep >= REP_GOOD { return 10000 }       // 1.0x
    if rep >= REP_WARNING { return 7000 }     // 0.7x (was 0.5x — slightly better for starting miners)
    if rep >= REP_CRITICAL { return 4000 }     // 0.4x (was 0.25x)
    return 0                                   // Banned = 0x
}

// v11.4: Get time-proven reputation bonus
// After 15 days of activity, miner gets +2000 reputation (from 3000 → 5000 = Good)
fn get_time_proven_bonus(miner: Miner) -> u64 {
    let current_topo: u64 = get_current_topoheight()
    if current_topo >= miner.registered_at + REP_PROVEN_BLOCKS {
        // Miner has been active for 15+ days — proven
        return 2000  // +2000 reputation bonus (3000 → 5000 = Good)
    }
    return 0
}

// v11.4: Get effective reputation (base + time bonus)
fn get_effective_reputation(miner: Miner) -> u64 {
    let rep: u64 = miner.reputation
    let time_bonus: u64 = get_time_proven_bonus(miner)
    rep += time_bonus
    if rep > REP_MAX { rep = REP_MAX }
    return rep
}

// v11.4: New miner bonus — depends on network miner count
// Fewer miners = higher bonus (incentivize joining when network is small)
// More miners = bonus disappears (natural equilibrium)
fn get_new_miner_bonus(miner: Miner, active_miners_count: u64) -> u64 {
    let current_topo: u64 = get_current_topoheight()
    // Only applies to miners registered less than 30 days ago
    let thirty_days: u64 = 2592000  // 30 * 86400 blocks
    if current_topo > miner.registered_at + thirty_days {
        return 0  // Bonus expired after 30 days
    }
    
    // Bonus depends on how many miners are active
    // 0-10 miners: 5000 bps (0.5x extra)
    // 11-50 miners: 3000 bps (0.3x extra)
    // 51-100 miners: 1000 bps (0.1x extra)
    // 100+ miners: 0 (no bonus, network is healthy)
    if active_miners_count <= 10 {
        return 5000
    }
    if active_miners_count <= 50 {
        return 3000
    }
    if active_miners_count <= 100 {
        return 1000
    }
    return 0
}

fn add_reputation(addr: Address, points: u64) {
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + addr.to_string())
    if miner_opt.is_none() { return }
    let miner: Miner = miner_opt.expect("err")
    miner.reputation += points
    if miner.reputation > REP_MAX { miner.reputation = REP_MAX }
    if miner.reputation >= REP_CRITICAL && miner.stake >= s.load(MIN_STAKE_KEY).unwrap_or(DEFAULT_MIN_STAKE) {
        miner.active = true
    }
    s.store(MINER_PREFIX + addr.to_string(), miner)
}

fn remove_reputation(addr: Address, points: u64) {
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + addr.to_string())
    if miner_opt.is_none() { return }
    let miner: Miner = miner_opt.expect("err")
    if miner.reputation > points { miner.reputation -= points } else { miner.reputation = 0 }
    miner.last_infraction_topo = get_current_topoheight()
    if miner.reputation < REP_CRITICAL { miner.active = false }
    s.store(MINER_PREFIX + addr.to_string(), miner)
}

// v10.11: Bitcoin-style halving — returns current per-block reward based on elapsed epochs
fn get_current_block_reward() -> u64 {
    let s: Storage = Storage::new()
    let launch_topo: u64 = s.load(LAUNCH_TOPO_KEY).unwrap_or(get_current_topoheight())
    let current_topo: u64 = get_current_topoheight()
    if current_topo <= launch_topo { return INITIAL_REWARD_PER_BLOCK }

    let elapsed: u64 = current_topo - launch_topo
    let epoch: u64 = elapsed / HALVING_INTERVAL_BLOCKS

    let reward: u64 = INITIAL_REWARD_PER_BLOCK
    let i: u64 = 0
    while i < epoch {
        reward = reward / 2
        if reward == 0 { return 0 }
        i += 1
    }
    return reward
}

// v11.1: Concentration thresholds (in bps of total stake)
// 0-8%: no penalty (1.0x), 8-20%: linear decrease to 0.3x, >20%: hard cap at 0.3x
const CONCENTRATION_SOFT_THRESHOLD_BPS: u64 = 800   // 8% — penalty starts
const CONCENTRATION_HARD_THRESHOLD_BPS: u64 = 2000  // 20% — penalty maxed
const CONCENTRATION_MIN_FACTOR_BPS: u64 = 3000      // 0.3x — minimum factor at hard threshold


pub fn get_active_miners_count() -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(MINERS_COUNT_KEY).unwrap_or(0)
    let active: u64 = 0
    let i: u64 = 0
    while i < count {
        let addr: Address = s.load(MINER_LIST_PREFIX + i.to_string(10u32)).expect("err")
        let miner: Miner = s.load(MINER_PREFIX + addr.to_string()).expect("err")
        if miner.active { active += 1 }
        i += 1
    }
    return active
}

fn get_dynamic_reward(base_reward: u64, miner_addr: Address) -> u64 {
    // v11.4: Bitcoin-style halving + STAKE_FLOOR + cap + time-proven rep + new miner bonus
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + miner_addr.to_string())
    if miner_opt.is_none() { return 0 }
    let miner: Miner = miner_opt.expect("err")

    // v11.4: Use EFFECTIVE reputation (base + time-proven bonus)
    let effective_rep: u64 = get_effective_reputation(miner)
    let rep_mult: u64 = get_reputation_multiplier(effective_rep)
    if rep_mult == 0 { return 0 }

    let total_staked: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    if total_staked == 0 { return 0 }

    let block_reward: u64 = get_current_block_reward()
    if block_reward == 0 { return 0 }

    // Cap stake per miner (anti-concentration hard cap)
    let effective_stake: u64 = miner.stake
    if effective_stake > CAP_STAKE_PER_MINER {
        effective_stake = CAP_STAKE_PER_MINER
    }

    // STAKE_FLOOR — bounds APY when few miners
    let effective_total: u64 = total_staked
    if effective_total < STAKE_FLOOR {
        effective_total = STAKE_FLOOR
    }

    // v11.4: New miner bonus — extra multiplier based on network size
    // Only for miners < 30 days old, depends on active miner count
    let active_count: u64 = get_active_miners_count()
    let new_miner_bonus: u64 = get_new_miner_bonus(miner, active_count)

    // reward = block_reward × effective_stake × rep_mult / (effective_total × 10000)
    //         × (1 + new_miner_bonus / 10000)
    let base_reward_val: u64 = (block_reward as u128 * effective_stake as u128 * rep_mult as u128 / (effective_total as u128 * 10000u128)) as u64
    let bonus_amount: u64 = (base_reward_val as u128 * new_miner_bonus as u128 / 10000u128) as u64
    return base_reward_val + bonus_amount
}

// ============================================================================
// FIX #13: maybe_adjust_budget — division by zero guard + remove duplicate
// target_rate declaration + clean clamp logic.
// ============================================================================
fn maybe_adjust_budget() {
    let s: Storage = Storage::new()
    let last_adjust: u64 = s.load(LAST_BUDGET_ADJUST_KEY).unwrap_or(0)
    let interval: u64 = s.load(BUDGET_ADJUST_INTERVAL_KEY).unwrap_or(DEFAULT_BUDGET_ADJUST_INTERVAL)
    let current_topo: u64 = get_current_topoheight()
    if current_topo < last_adjust + interval { return }

    let total_budget: u64 = s.load(TOTAL_BUDGET_KEY).unwrap_or(DEFAULT_TOTAL_BUDGET)
    let distributed: u64 = s.load(DISTRIBUTED_KEY).unwrap_or(0)
    let remaining_budget: u64 = 0
    if total_budget > distributed {
        remaining_budget = total_budget - distributed
    } else {
        remaining_budget = 0
    }

    let launch_topo: u64 = s.load(LAUNCH_TOPO_KEY).unwrap_or(current_topo)
    let elapsed: u64 = 0
    if current_topo > launch_topo {
        elapsed = current_topo - launch_topo
    } else {
        elapsed = 1
    }
    let target_duration: u64 = s.load(TARGET_DURATION_BLOCKS_KEY).unwrap_or(DEFAULT_TARGET_DURATION)
    let remaining_time: u64 = 0
    if target_duration > elapsed {
        remaining_time = target_duration - elapsed
    } else {
        remaining_time = 1
    }

    // FIX #13: single target_rate declaration + division-by-zero guard
    let token_count: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    if token_count == 0 {
        // No miners yet — no adjustment needed
        s.store(LAST_BUDGET_ADJUST_KEY, current_topo)
        return
    }
    let target_rate: u64 = (remaining_budget as u128 / remaining_time as u128) as u64

    let actual_rate: u64 = (distributed as u128 / elapsed as u128) as u64
    let current_factor: u64 = s.load(BUDGET_FACTOR_KEY).unwrap_or(DEFAULT_BUDGET_FACTOR)
    let new_factor: u64 = current_factor

    if actual_rate > target_rate && target_rate > 0 {
        // We are distributing too fast — scale down proportionally
        let ratio: u64 = (target_rate as u128 * 10000u128 / actual_rate as u128) as u64
        new_factor = (current_factor * ratio) / 10000
    } else if actual_rate == 0 {
        // No distribution yet — slight bump to encourage
        new_factor = current_factor * 110 / 100
    } else if actual_rate < target_rate / 2 {
        // We are distributing too slow — scale up
        let ratio: u64 = (target_rate as u128 * 10000u128 / actual_rate as u128) as u64
        new_factor = (current_factor + ratio * current_factor / 10000) / 2
    }

    // Symmetric clamp
    let clamped: u64 = new_factor
    if new_factor < 5000 { clamped = 5000 }
    if new_factor > 20000 { clamped = 20000 }
    s.store(BUDGET_FACTOR_KEY, clamped)
    s.store(LAST_BUDGET_ADJUST_KEY, current_topo)
}

// ============================================================================


// ENTRIES (sequential IDs starting at 0)
// ============================================================================
// ID 0: register_miner
// Register a new miner with the protocol. Locks min stake deposit and stores the miner record.
// @caller: any user with sufficient VLT deposit
// @params: endpoint_url - public URL where the miner's daemon is reachable
// @params: miner_pubkey - Ed25519 public key used for signing heartbeats and submissions
// @params: services_mask - bitmask of services the miner will run (1=oracle, 2=chat, 3=both)
// @returns: 0 on success
// @security: when_not_paused, rejects duplicate registration, requires attached deposit >= MIN_STAKE, excess deposit refunded to caller
entry register_miner(endpoint_url: string, miner_pubkey: Hash, services_mask: u8) -> u64 {
    when_not_paused()
    require(endpoint_url != "", "badurl")
    require(miner_pubkey != Hash::zero(), "badpubkey")
    require(services_mask > 0, "noservices")

    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let existing: optional<Miner> = s.load(MINER_PREFIX + caller.to_string())
    require(existing.is_none(), "already")

    let vlt_asset: Hash = s.load(VLT_ASSET_KEY).expect("err")
    let dep: u64 = get_deposit_for_asset(vlt_asset).expect("err")
    let min_stake: u64 = s.load(MIN_STAKE_KEY).unwrap_or(DEFAULT_MIN_STAKE)
    require(dep >= min_stake, "insstake")
    if dep > min_stake { transfer(caller, dep - min_stake, vlt_asset) }

    let count: u64 = s.load(MINERS_COUNT_KEY).unwrap_or(0)
    let miner: Miner = Miner {
        addr: caller,
        endpoint_url: endpoint_url,
        miner_pubkey: miner_pubkey,
        stake: min_stake,
        services_mask: services_mask,
        registered_at: get_current_topoheight(),
        last_heartbeat: get_current_topoheight(),
        total_rewards_earned: 0,
        total_slashed: 0,
        reputation: REP_START,  // v11.4: Start at 3000 (between Warning and Good), must prove over time
        valid_submissions: 0,
        successful_anchors: 0,
        total_submissions: 0,
        last_infraction_topo: 0,
        active: true
    }
    s.store(MINER_PREFIX + caller.to_string(), miner)
    s.store(MINER_LIST_PREFIX + count.to_string(10u32), caller)
    s.store(MINERS_COUNT_KEY, count + 1)

    if services_mask & 1 != 0 {
        let c: u64 = s.load(SERVICE_MINERS_PREFIX + "1").unwrap_or(0)
        s.store(SERVICE_MINERS_PREFIX + "1", c + 1)
    }
    if services_mask & 2 != 0 {
        let c: u64 = s.load(SERVICE_MINERS_PREFIX + "2").unwrap_or(0)
        s.store(SERVICE_MINERS_PREFIX + "2", c + 1)
    }

    let total_staked: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    s.store(TOTAL_STAKED_KEY, total_staked + min_stake)
    return 0
}

// ID 1: enable_service
// Enable an additional service bit on an already-registered miner account.
// @caller: the miner themselves (must already be registered)
// @params: service_id - service slot to enable (1..=8, 1=oracle, 2=chat)
// @returns: 0 on success
// @security: when_not_paused, requires existing miner record, rejects re-enabling an already-active service
entry enable_service(service_id: u8) -> u64 {
    when_not_paused()
    require(service_id >= 1 && service_id <= 8, "badservice")
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let miner: Miner = s.load(MINER_PREFIX + caller.to_string()).expect("err")
    let bit: u8 = 1 << (service_id - 1)
    require(miner.services_mask & bit == 0, "alreadyon")
    miner.services_mask = miner.services_mask | bit
    s.store(MINER_PREFIX + caller.to_string(), miner)
    let c: u64 = s.load(SERVICE_MINERS_PREFIX + service_id.to_string(10u32)).unwrap_or(0)
    s.store(SERVICE_MINERS_PREFIX + service_id.to_string(10u32), c + 1)
    return 0
}

// ID 2: disable_service
// Disable a service bit on the caller's miner account (does not deregister the miner).
// @caller: the miner themselves
// @params: service_id - service slot to disable (1..=8)
// @returns: 0 on success
// @security: requires existing miner record, rejects disabling an inactive service; intentionally callable while paused (graceful wind-down)
entry disable_service(service_id: u8) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let miner: Miner = s.load(MINER_PREFIX + caller.to_string()).expect("err")
    let bit: u8 = 1 << (service_id - 1)
    require(miner.services_mask & bit != 0, "alreadyoff")
    miner.services_mask = miner.services_mask & (255 - bit)
    s.store(MINER_PREFIX + caller.to_string(), miner)
    let c: u64 = s.load(SERVICE_MINERS_PREFIX + service_id.to_string(10u32)).unwrap_or(0)
    if c > 0 { s.store(SERVICE_MINERS_PREFIX + service_id.to_string(10u32), c - 1) }
    return 0
}

// ID 3: increase_stake
// Add additional VLT stake to an existing miner account; may reactivate an inactive miner.
// @caller: the miner themselves
// @params: amount - additional VLT to lock (must be > 0 and covered by attached deposit)
// @returns: 0 on success
// @security: when_not_paused, requires attached deposit >= amount, excess deposit refunded, reactivates miner if remaining stake crosses MIN_STAKE
entry increase_stake(amount: u64) -> u64 {
    when_not_paused()
    require(amount > 0, "amtgt0")
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let miner: Miner = s.load(MINER_PREFIX + caller.to_string()).expect("err")
    let vlt_asset: Hash = s.load(VLT_ASSET_KEY).expect("err")
    let dep: u64 = get_deposit_for_asset(vlt_asset).expect("err")
    require(dep >= amount, "insdep")
    if dep > amount { transfer(caller, dep - amount, vlt_asset) }
    miner.stake += amount
    if !miner.active && miner.stake >= s.load(MIN_STAKE_KEY).unwrap_or(DEFAULT_MIN_STAKE) {
        miner.active = true
    }
    s.store(MINER_PREFIX + caller.to_string(), miner)
    let total_staked: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    s.store(TOTAL_STAKED_KEY, total_staked + amount)

    // v11.0: Push own_stake update to MinerDelegation if configured
    let del_opt: optional<Hash> = s.load(DELEGATION_CONTRACT_KEY)
    if del_opt.is_some() {
        let del_hash: Hash = del_opt.expect("err")
        if del_hash != Hash::zero() {
            let del: Contract = Contract::new(del_hash).expect("err")
            // MinerDelegation entry 9 = set_miner_own_stake
            let _ = del.call(36u16, [caller, miner.stake], {})
        }
    }
    return 0
}
// Withdraw part of the locked VLT stake back to the miner; may deactivate if remaining stake falls below MIN_STAKE.
// @caller: the miner themselves
// @params: amount - VLT to withdraw (must be > 0 and <= current stake)
// @returns: 0 on success
// @security: when_not_paused, requires stake >= amount, transfer must succeed, deactivates miner if remaining stake < MIN_STAKE
entry decrease_stake(amount: u64) -> u64 {
    when_not_paused()
    require(amount > 0, "amtgt0")
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let miner: Miner = s.load(MINER_PREFIX + caller.to_string()).expect("err")
    require(miner.stake >= amount, "insstake")
    let vlt_asset: Hash = s.load(VLT_ASSET_KEY).expect("err")
    let ok: bool = transfer(caller, amount, vlt_asset)
    require(ok, "txfail")
    miner.stake -= amount
    let min_stake: u64 = s.load(MIN_STAKE_KEY).unwrap_or(DEFAULT_MIN_STAKE)
    if miner.stake < min_stake { miner.active = false }
    s.store(MINER_PREFIX + caller.to_string(), miner)
    let total_staked: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    if total_staked >= amount { s.store(TOTAL_STAKED_KEY, total_staked - amount) }

    // v11.0: Push own_stake update to MinerDelegation if configured
    let del_opt2: optional<Hash> = s.load(DELEGATION_CONTRACT_KEY)
    if del_opt2.is_some() {
        let del_hash: Hash = del_opt2.expect("err")
        if del_hash != Hash::zero() {
            let del: Contract = Contract::new(del_hash).expect("err")
            let _ = del.call(36u16, [caller, miner.stake], {})
        }
    }
    return 0
}

// ID 5: deregister_miner
// Fully deregister a miner: refunds the entire remaining stake and removes the miner record.
// @caller: the miner themselves
// @returns: 0 on success
// @security: requires existing miner record; intentionally callable while paused (exit door); refund transfer must succeed
entry deregister_miner() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let miner: Miner = s.load(MINER_PREFIX + caller.to_string()).expect("err")
    let vlt_asset: Hash = s.load(VLT_ASSET_KEY).expect("err")
    let ok: bool = transfer(caller, miner.stake, vlt_asset)
    require(ok, "txfail")
    let total_staked: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    if total_staked >= miner.stake { s.store(TOTAL_STAKED_KEY, total_staked - miner.stake) }
    if miner.services_mask & 1 != 0 {
        let c: u64 = s.load(SERVICE_MINERS_PREFIX + "1").unwrap_or(0)
        if c > 0 { s.store(SERVICE_MINERS_PREFIX + "1", c - 1) }
    }
    if miner.services_mask & 2 != 0 {
        let c: u64 = s.load(SERVICE_MINERS_PREFIX + "2").unwrap_or(0)
        if c > 0 { s.store(SERVICE_MINERS_PREFIX + "2", c - 1) }
    }
    s.delete(MINER_PREFIX + caller.to_string())
    return 0
}

// ID 6: submit_heartbeat
// Submit a liveness heartbeat for the caller's miner; small reputation gain if recent.
// @caller: the miner themselves (must be active)
// @returns: 0 on success
// @security: requires active miner, enforces HEARTBEAT_INTERVAL spacing between heartbeats; intentionally callable while paused; triggers maybe_adjust_budget()
entry submit_heartbeat() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let miner: Miner = s.load(MINER_PREFIX + caller.to_string()).expect("err")
    require(miner.active, "inactive")
    let current_topo: u64 = get_current_topoheight()
    let interval: u64 = s.load(HEARTBEAT_INTERVAL_KEY).unwrap_or(DEFAULT_HEARTBEAT_INTERVAL)
    require(current_topo >= miner.last_heartbeat + interval, "toosoon")
    miner.last_heartbeat = current_topo
    if current_topo > miner.last_infraction_topo + 1000 {
        if miner.reputation < REP_MAX {
            miner.reputation += REP_GAIN_HEARTBEAT
            if miner.reputation > REP_MAX { miner.reputation = REP_MAX }
        }
    }
    s.store(MINER_PREFIX + caller.to_string(), miner)
    maybe_adjust_budget()
    return 0
}

// ============================================================================
// FIX #1: Convert pub fn → entry for slash_miner, distribute_reward,
// is_miner_active so StakedOracle can call them via Contract::call.
// These are now entries 7, 8, 9.
// ============================================================================

// ID 7: slash_miner (was pub fn — unreachable cross-contract)
// Slash a miner's stake and reputation for an infraction; distributes slash across burn / reporter / treasury.
// @caller: authorized_service only (e.g. StakedOracle contract)
// @params: miner_addr - address of the miner to slash
// @params: severity - infraction severity 0..4 (0=outlier, 1=offline, 2=data_loss, 3=censorship, 4=malicious)
// @params: reporter - address receiving the 10% reporter reward
// @returns: slash_amount actually deducted from stake
// @security: only_authorized_service, no-op for unknown miner, deactivates miner if stake or reputation drops below thresholds
pub fn slash_miner(miner_addr: Address, severity: u8, reporter: Address) -> u64 {
    only_authorized_service()
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + miner_addr.to_string())
    if miner_opt.is_none() { return 0 }
    let miner: Miner = miner_opt.expect("err")

    let slash_bps: u64 = 0
    let rep_loss: u64 = 0
    if severity == 0 { slash_bps = 100; rep_loss = REP_LOSS_OUTLIER }
    else if severity == 1 { slash_bps = 200; rep_loss = REP_LOSS_OFFLINE }
    else if severity == 2 { slash_bps = 500; rep_loss = REP_LOSS_DATA_LOSS }
    else if severity == 3 { slash_bps = 1000; rep_loss = REP_LOSS_CENSORSHIP }
    else { slash_bps = 5000; rep_loss = REP_LOSS_MALICIOUS }

    let slash_amount: u64 = (miner.stake as u128 * slash_bps as u128 / 10000u128) as u64
    if slash_amount > 0 {
        let actual_slash: u64 = 0
        if slash_amount > miner.stake { actual_slash = miner.stake } else { actual_slash = slash_amount }
        miner.stake -= actual_slash
        miner.total_slashed += actual_slash
        let min_stake: u64 = s.load(MIN_STAKE_KEY).unwrap_or(DEFAULT_MIN_STAKE)
        if miner.stake < min_stake { miner.active = false }
    }

    if miner.reputation > rep_loss { miner.reputation -= rep_loss } else { miner.reputation = 0 }
    miner.last_infraction_topo = get_current_topoheight()
    if miner.reputation < REP_CRITICAL { miner.active = false }
    s.store(MINER_PREFIX + miner_addr.to_string(), miner)

    let total_staked: u64 = s.load(TOTAL_STAKED_KEY).unwrap_or(0)
    if total_staked >= slash_amount { s.store(TOTAL_STAKED_KEY, total_staked - slash_amount) }

    let burn_amount: u64 = slash_amount / 2
    let reporter_reward: u64 = slash_amount / 10
    let treasury_amount: u64 = slash_amount - burn_amount - reporter_reward

    let vlt_asset: Hash = s.load(VLT_ASSET_KEY).expect("err")
    if burn_amount > 0 { let _ = burn(burn_amount, vlt_asset) }
    if reporter_reward > 0 { transfer(reporter, reporter_reward, vlt_asset) }
    if treasury_amount > 0 {
        let treasury: Address = s.load(TREASURY_KEY).expect("err")
        transfer(treasury, treasury_amount, vlt_asset)
    }
    return slash_amount
}

// ID 8: distribute_reward (was pub fn)
// Mint a dynamic reward to a miner for a valid (or invalid) submission; updates reputation and budget accounting.
// @caller: authorized_service only (e.g. StakedOracle contract)
// @params: miner_addr - address of the miner being rewarded
// @params: service_id - service that produced the submission (1=oracle, 2=chat)
// @params: is_valid - whether the submission was valid (invalid = no mint, just counter bump)
// @returns: reward amount minted (0 if inactive / invalid / no budget)
// @security: only_authorized_service, no-op for unknown or inactive miner, refuses to mint if reward would exceed remaining budget, calls VLTToken chunk 4 (pub fn mint_to) cross-contract
pub fn distribute_reward(miner_addr: Address, service_id: u8, is_valid: bool) -> u64 {
    only_authorized_service()
    let s: Storage = Storage::new()

    // v10.9: Check if rewards are frozen (emergency)
    let rewards_frozen: bool = s.load("rewards_frozen").unwrap_or(false)
    if rewards_frozen { return 0 }

    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + miner_addr.to_string())
    if miner_opt.is_none() { return 0 }
    let miner: Miner = miner_opt.expect("err")
    if !miner.active { return 0 }

    miner.total_submissions += 1
    if !is_valid {
        s.store(MINER_PREFIX + miner_addr.to_string(), miner)
        return 0
    }

    let base_reward: u64 = s.load(BASE_REWARD_ORACLE_KEY).unwrap_or(DEFAULT_BASE_REWARD_ORACLE)
    if service_id == 2 {
        base_reward = s.load(BASE_REWARD_CHAT_KEY).unwrap_or(DEFAULT_BASE_REWARD_CHAT)
    }
    if base_reward == 0 { return 0 }

    let reward: u64 = get_dynamic_reward(base_reward, miner_addr)
    if reward == 0 {
        s.store(MINER_PREFIX + miner_addr.to_string(), miner)
        return 0
    }

    let distributed: u64 = s.load(DISTRIBUTED_KEY).unwrap_or(0)
    let total_budget: u64 = s.load(TOTAL_BUDGET_KEY).unwrap_or(DEFAULT_TOTAL_BUDGET)
    if distributed + reward > total_budget {
        s.store(MINER_PREFIX + miner_addr.to_string(), miner)
        return 0
    }

    let vlt_hash: Hash = s.load(VLT_CONTRACT_KEY).expect("err")
    let vlt: Contract = Contract::new(vlt_hash).expect("err")
    // v11.7 fix: cross-contract calls require Access::All (`pub fn`).
    //   VLTToken chunk 4 = pub fn mint_to (All); chunk 27 (mint_to_entry) is an
    //   Entry — wallet-only, reverted "Chunk is not public" when called here.
    let mint_result: u64 = vlt.call(4u16, [miner_addr, reward], {})
    require(mint_result == 0, "mintfail")

    miner.total_rewards_earned += reward
    miner.valid_submissions += 1
    if service_id == 2 { miner.successful_anchors += 1 }

    let rep_gain: u64 = 0
    if service_id == 1 { rep_gain = REP_GAIN_PRICE } else { rep_gain = REP_GAIN_ANCHOR }
    if miner.reputation < REP_MAX {
        miner.reputation += rep_gain
        if miner.reputation > REP_MAX { miner.reputation = REP_MAX }
    }
    s.store(MINER_PREFIX + miner_addr.to_string(), miner)
    s.store(DISTRIBUTED_KEY, distributed + reward)
    maybe_adjust_budget()
    return reward
}

// ID 9: is_miner_active_entry (was pub fn is_miner_active)
// Returns 1 if active for the service, 0 otherwise (since entry return is u64 by default)
// Cross-contract entry: check whether a miner is active for a specific service (1=active, 0=inactive).
// @caller: anyone (read-only)
// @params: addr - miner address to query
// @params: service_id - service bit to test (1..=8)
// @returns: 1 if the miner is active, staked, reputable and opted into the service; 0 otherwise
// @security: read-only, no access control
pub fn is_miner_active(addr: Address, service_id: u8) -> u64 {
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + addr.to_string())
    if miner_opt.is_none() { return 0 }
    let miner: Miner = miner_opt.expect("err")
    if !miner.active { return 0 }
    if miner.reputation < REP_CRITICAL { return 0 }
    let bit: u8 = 1 << (service_id - 1)
    if miner.services_mask & bit != 0 { return 1 }
    return 0
}

// ID 10: get_miner_stake_entry (was pub fn)
// Cross-contract entry: return the current locked stake of a miner.
// @caller: anyone (read-only)
// @params: addr - miner address to query
// @returns: stake amount, or 0 if miner does not exist
// @security: read-only, no access control
entry get_miner_stake_entry(addr: Address) -> u64 {
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + addr.to_string())
    if miner_opt.is_none() { return 0 }
    let miner: Miner = miner_opt.expect("err")
    return miner.stake
}

// ID 11: get_miner_reputation_entry
// Cross-contract entry: return the reputation score of a miner (0..=10000).
// @caller: anyone (read-only)
// @params: addr - miner address to query
// @returns: reputation score, or 0 if miner does not exist
// @security: read-only, no access control
entry get_miner_reputation_entry(addr: Address) -> u64 {
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + addr.to_string())
    if miner_opt.is_none() { return 0 }
    let miner: Miner = miner_opt.expect("err")
    return miner.reputation
}

// ID 12: get_active_miners_for_service_entry (was pub fn)
// Cross-contract entry: return how many miners are currently opted into a service.
// @caller: anyone (read-only)
// @params: service_id - service slot to query (1..=8)
// @returns: count of miners with that service bit set in their services_mask
// @security: read-only, no access control
pub fn get_active_miners_for_service(service_id: u8) -> u64 {
    return Storage::new().load(SERVICE_MINERS_PREFIX + service_id.to_string(10u32)).unwrap_or(0)
}

// ID 13: get_miners_count_entry
