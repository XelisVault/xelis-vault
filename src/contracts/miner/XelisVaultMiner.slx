entry set_vlt_asset(va: Hash) -> u64 { only_admin() Storage::new().store(VLT_ASSET_KEY, va) return 0 }

// v11.0: Set MinerDelegation contract (for pushing own_stake updates)
entry set_delegation_contract(dck: Hash) -> u64 { only_admin() Storage::new().store(DELEGATION_CONTRACT_KEY, dck) return 0 }

