// @security: read-only view, no access control
// get version.
entry get_version() -> string {
    return VERSION
}

// ID 29: request_emergency_withdraw
// First step of the 2-step emergency withdraw: record the current topoheight as the request timestamp.
// @caller: emergency role
// @returns: 0 on success
// @security: only_emergency, starts 17280-block (~24h) timelock before execution
// request emergency withdraw.
entry request_emergency_withdraw() -> u64 {
    only_emergency()
    Storage::new().store(EMERGENCY_REQUEST_TOPO_KEY, get_current_topoheight())
    return 0
}

// ID 30: execute_emergency_withdraw
// Second step of the 2-step emergency withdraw: sweep the entire balance of an asset to the emergency role.
// @caller: emergency role
// @params: asset - which asset Hash to withdraw fully
// @returns: 0 on success
// @security: only_emergency, requires prior request_emergency_withdraw, enforced 17280-block delay, single-use (deletes request key)
// execute emergency withdraw.
entry execute_emergency_withdraw(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let e: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == e, "notemg")
    let req_topo: u64 = s.load(EMERGENCY_REQUEST_TOPO_KEY).unwrap_or(0)
    require(req_topo > 0, "norequest")
    let now_topo: u64 = get_current_topoheight()
    require(now_topo >= req_topo + EMERGENCY_DELAY_BLOCKS, "toosoon")
    s.delete(EMERGENCY_REQUEST_TOPO_KEY)
    let bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    if bal > 0 {
        let _ = transfer(caller, bal, asset)
    }
    return 0
}

// ============================================================================
// pub fn (read-only) — not counted for entry IDs
// ============================================================================

// Return the reserves, last price, and PSM flag for a pool identified by asset pair.
// @caller: anyone
// @params: asset_a - first asset Hash
// @params: asset_b - second asset Hash
// @returns: tuple (reserve_a, reserve_b, last_price, is_psm); returns (0,0,0,false) if pool doesn't exist
// @security: read-only view, no access control
// get pool.
pub fn get_pool(asset_a: Hash, asset_b: Hash) -> (u64, u64, u64, bool) {
    let s: Storage = Storage::new()
    let key: string = get_pool_key(asset_a, asset_b)
    let pool_opt: optional<Pool> = s.load(key)
    if pool_opt.is_none() { return (0, 0, 0, false) }
    let pool: Pool = pool_opt.expect("err")
    return (pool.reserve_a, pool.reserve_b, pool.last_price, pool.is_psm)
}

// Compute the expected output amount for a swap given current reserves and dynamic fee.
// @caller: anyone
// @params: asset_in - asset being sold
// @params: asset_out - asset being bought
// @params: amount_in - input amount to quote
// @returns: expected output amount (0 if pool missing)
// @security: read-only view, no access control
// get amount out view.
pub fn get_amount_out_view(asset_in: Hash, asset_out: Hash, amount_in: u64) -> u64 {
    let s: Storage = Storage::new()
    let key: string = get_pool_key(asset_in, asset_out)
    let pool_opt: optional<Pool> = s.load(key)
    if pool_opt.is_none() { return 0 }
    let pool: Pool = pool_opt.expect("err")
    let is_a_to_b: bool = (asset_in == pool.asset_a)
    let reserve_in: u64 = 0
    if is_a_to_b { reserve_in = pool.reserve_a } else { reserve_in = pool.reserve_b }
    let reserve_out: u64 = 0
    if is_a_to_b { reserve_out = pool.reserve_b } else { reserve_out = pool.reserve_a }
    let fee_bps: u64 = current_fee_bps(key)
    return get_amount_out(amount_in, reserve_in, reserve_out, fee_bps)
}

// Return the 30-sample time-weighted average price for a pool.
// @caller: anyone
// @params: asset_a - first asset Hash
// @params: asset_b - second asset Hash
// @returns: TWAP price scaled by PRICE_DECIMALS, 0 if no samples
// @security: read-only view, no access control
// get twap.
pub fn get_twap(asset_a: Hash, asset_b: Hash) -> u64 {
    let key: string = get_pool_key(asset_a, asset_b)
    return twap_get(key)
}

// Return the TWAP-based volatility (max-min)/mean in basis points for a pool.
// @caller: anyone
// @params: asset_a - first asset Hash
// @params: asset_b - second asset Hash
// @returns: volatility in bps; 0 if fewer than 2 samples
// @security: read-only view, no access control
// get volatility bps.
pub fn get_volatility_bps(asset_a: Hash, asset_b: Hash) -> u64 {
    let key: string = get_pool_key(asset_a, asset_b)
    return twap_volatility_bps(key)
}

// Return the total number of registered pools.
// @caller: anyone
// @returns: count of pools
// @security: read-only view, no access control
// get pools count.
pub fn get_pools_count() -> u64 {
    return Storage::new().load(POOLS_COUNT_KEY).unwrap_or(0)
}

// Return the pool details at a given numeric index (enumeration helper).
// @caller: anyone
// @params: index - pool index (0..pools_count-1)
// @returns: tuple (asset_a, asset_b, reserve_a, reserve_b, last_price, is_psm)
// @security: read-only view, no access control; panics if index out of range
// get pool by index.
pub fn get_pool_by_index(index: u64) -> (Hash, Hash, u64, u64, u64, bool) {
    let s: Storage = Storage::new()
    let key: string = s.load(POOL_ID_PREFIX + index.to_string(10u32)).expect("err")
    let pool: Pool = s.load(key).expect("err")
    return (pool.asset_a, pool.asset_b, pool.reserve_a, pool.reserve_b, pool.last_price, pool.is_psm)
}

// Return all current fee configuration values in basis points.
// @caller: anyone
// @returns: tuple (base_fee, treasury_fee, max_volatility, high_vol_fee, max_swap_pct, psm_mint_fee)
// @security: read-only view, no access control
// get fees.
pub fn get_fees() -> (u64, u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(BASE_FEE_BPS_KEY).unwrap_or(DEFAULT_BASE_FEE),
        s.load(TREASURY_FEE_BPS_KEY).unwrap_or(DEFAULT_TREASURY_FEE),
        s.load(MAX_VOLATILITY_BPS_KEY).unwrap_or(DEFAULT_MAX_VOL),
        s.load(HIGH_VOL_FEE_BPS_KEY).unwrap_or(DEFAULT_HIGH_VOL_FEE),
        s.load(MAX_SWAP_PCT_BPS_KEY).unwrap_or(DEFAULT_MAX_SWAP_PCT),
        s.load(PSM_MINT_FEE_KEY).unwrap_or(DEFAULT_PSM_MINT_FEE)
    )
}

// Set the timelock contract hash (alternate admin path via contract-caller check).
// @caller: admin or timelock
// @params: tl - new timelock contract Hash
// @returns: 0 on success
// @security: only_admin, mirrors the entry version for read-only callers
// set timelock tl.
pub fn set_timelock_tl(tl: Hash) -> u64 {
    only_admin()
    Storage::new().store(TIMELOCK_KEY, tl)
    return 0
}

// ============================================================================
// AUDIT FIX F-10 (MEDIUM) v11.5 — set_psm_contract
// ----------------------------------------------------------------------------
// Configures the canonical PSM.slx contract hash that psm_mint / psm_redeem
// delegate to. Without this configuration, psm_mint / psm_redeem revert with
// "nopsm" — there is no longer a duplicate local mint/redeem path.
// ============================================================================
entry set_psm_contract(psm: Hash) -> u64 {
    only_admin()
    require(psm != Hash::zero(), "badhash")
    Storage::new().store(PSM_CONTRACT_KEY, psm)
    emit_event(0u64, ["PSMContractSet", psm.to_hex()])
    return 0
}

// pub fn: read the configured PSM contract hash (Hash::zero() if not configured)
pub fn get_psm_contract() -> Hash {
    let s: Storage = Storage::new()
    let psm_opt: optional<Hash> = s.load(PSM_CONTRACT_KEY)
    if psm_opt.is_none() { return Hash::zero() }
    return psm_opt.expect("err")
}
