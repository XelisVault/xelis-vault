entry get_fees_entry() -> (u64, u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(BASE_FEE_BPS_KEY).unwrap_or(DEFAULT_BASE_FEE),
        s.load(TREASURY_FEE_BPS_KEY).unwrap_or(DEFAULT_TREASURY_FEE),
        s.load(MAX_VOLATILITY_BPS_KEY).unwrap_or(DEFAULT_MAX_VOL),
        s.load(HIGH_VOL_FEE_BPS_KEY).unwrap_or(DEFAULT_HIGH_VOL_FEE),
        s.load(MAX_SWAP_PCT_BPS_KEY).unwrap_or(DEFAULT_MAX_SWAP_PCT),
        s.load(PSM_MINT_FEE_KEY).unwrap_or(DEFAULT_PSM_MINT_FEE)
    )
}

// ID 12: pause
// Pause all swap / liquidity / PSM operations, recording the pause reason.
// @caller: guardian or admin
// @params: reason - human-readable pause reason (stored on-chain)
// @returns: 0 on success
// @security: only_guardian_or_admin, sets PAUSED_KEY to true
// pause.
entry pause(reason: string) -> u64 {
    only_guardian_or_admin()
    let s: Storage = Storage::new()
    s.store(PAUSED_KEY, true)
    s.store("pausereason", reason)
    return 0
}

// ID 13: unpause
// Resume all swap / liquidity / PSM operations after a pause.
// @caller: admin or timelock
// @returns: 0 on success
// @security: only_admin (stricter than pause)
// unpause.
entry unpause() -> u64 {
    only_admin()
    Storage::new().store(PAUSED_KEY, false)
    return 0
}

// ID 14: set_base_fee_bps
// Update the base AMM swap fee in basis points (capped at 500 bps = 5%).
// @caller: admin or timelock
// @params: f - new base fee bps (0..=500)
// @returns: 0 on success
// @security: only_admin, bounds-checked
// set base fee bps.
entry set_base_fee_bps(f: u64) -> u64 {
    only_admin()
    require(f <= 500, "badval")
    Storage::new().store(BASE_FEE_BPS_KEY, f)
    return 0
}

// ID 15: set_treasury_fee_bps
// Update the treasury fee (taken from swap output) in basis points (capped at 100 bps = 1%).
// @caller: admin or timelock
// @params: f - new treasury fee bps (0..=100)
// @returns: 0 on success
// @security: only_admin, bounds-checked
// set treasury fee bps.
entry set_treasury_fee_bps(f: u64) -> u64 {
    only_admin()
    require(f <= 100, "badval")
    Storage::new().store(TREASURY_FEE_BPS_KEY, f)
    return 0
}

// ID 16: set_max_volatility_bps
// Update the circuit-breaker threshold: max allowed single-swap price move in bps (100..=5000).
// @caller: admin or timelock
// @params: v - new max volatility bps
// @returns: 0 on success
// @security: only_admin, bounds-checked (1%..=50%)
// set max volatility bps.
entry set_max_volatility_bps(v: u64) -> u64 {
    only_admin()
    require(v >= 100 && v <= 5000, "badval")
    Storage::new().store(MAX_VOLATILITY_BPS_KEY, v)
    return 0
}

// ID 17: set_max_swap_pct_bps
// Update the per-swap cap as a percentage of input reserve in bps (100..=2000 = 1%..=20%).
// @caller: admin or timelock
// @params: p - new max swap pct bps
// @returns: 0 on success
// @security: only_admin, bounds-checked
// set max swap pct bps.
entry set_max_swap_pct_bps(p: u64) -> u64 {
    only_admin()
    require(p >= 100 && p <= 2000, "badval")
    Storage::new().store(MAX_SWAP_PCT_BPS_KEY, p)
    return 0
}

