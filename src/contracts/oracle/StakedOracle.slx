// ID 7: get_price_by_feed_entry
// Cross-contract entry: return the latest aggregated price for a feed by id.
// @caller: anyone (read-only)
// @params: feed_id - id of the feed to read
// @returns: latest aggregated price
// @security: read-only; enforces not-paused, not-circuit-broken, min-providers and hard-stale bounds via get_price_by_feed_impl
entry get_price_by_feed_entry(feed_id: u64) -> u64 {
    return get_price_by_feed_impl(feed_id)
}

// ID 8: get_price_entry
// Cross-contract entry: return the latest aggregated price for a feed by name.
// @caller: anyone (read-only)
// @params: name - feed name to resolve
// @returns: latest aggregated price
// @security: read-only; resolves name -> feed_id then delegates to get_price_by_feed_impl
entry get_price_entry(name: string) -> u64 {
    return get_price_by_feed_impl(get_feed_id_impl(name))
}

// ID 9: get_price_for_asset_entry
// Cross-contract entry: return the latest aggregated price for the first feed matching an asset hash.
// @caller: anyone (read-only)
// @params: asset - asset hash to look up
// @returns: latest aggregated price
// @security: read-only; iterates feeds linearly, requires at least one feed for the asset, delegates to get_price_by_feed_impl
entry get_price_for_asset_entry(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(FEEDS_COUNT_KEY).unwrap_or(0)
    let i: u64 = 0
    while i < count {
        let feed: Feed = s.load(FEED_PREFIX + i.to_string(10u32)).expect("fnf")
        if feed.asset == asset { return get_price_by_feed_impl(i) }
        i += 1
    }
    require(false, "assetnofeed")
    return 0
}

// ID 10: get_feed_id_entry
// Cross-contract entry: resolve a feed's numeric id from its name.
// @caller: anyone (read-only)
// @params: name - feed name to resolve
// @returns: feed id (reverts with "feednotfound" if unknown)
// @security: read-only; iterates feeds linearly
entry get_feed_id_entry(name: string) -> u64 {
    return get_feed_id_impl(name)
}

// ID 11: pause
// Halt all state-mutating user entries (submit_price, etc.).
// @caller: guardian or admin
// @params: reason - free-form reason string (off-chain audit trail only)
// @returns: 0 on success
// @security: only_guardian_or_admin; sets PAUSED_KEY = true; read-only entries remain callable
pub fn pause(reason: string) -> u64 {
    only_guardian_or_admin()
    Storage::new().store(PAUSED_KEY, true)
    return 0
}

// ID 12: unpause
// Resume normal operation after a pause.
// @caller: admin only (guardian cannot unpause, only pause)
// @returns: 0 on success
// @security: only_admin; sets PAUSED_KEY = false
pub fn unpause() -> u64 {
    only_admin()
    Storage::new().store(PAUSED_KEY, false)
    return 0
}

// ID 13: set_max_deviation_bps
// Update the global max deviation (in bps) tolerated between providers during aggregation before slashing all.
// @caller: admin (or timelock as contract caller)
// @params: bps - new max deviation in basis points (must be in [100, 5000])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
pub fn set_max_deviation_bps(bps: u64) -> u64 {
    only_admin()
    require(bps >= 100 && bps <= 5000, "badval")
    Storage::new().store(MAX_DEVIATION_BPS_KEY, bps)
    return 0
}

// ID 14: set_cb_threshold_bps
// Update the per-feed circuit-breaker threshold: how much the new median may move vs the previous aggregated price.
// @caller: admin (or timelock as contract caller)
// @params: bps - new CB threshold in basis points (must be in [500, 5000])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
pub fn set_cb_threshold_bps(bps: u64) -> u64 {
    only_admin()
    require(bps >= 500 && bps <= 5000, "badval")
    Storage::new().store(CB_THRESHOLD_BPS_KEY, bps)
    return 0
}

// ID 15: set_aggregation_blocks
// Update the minimum number of blocks between two aggregations of the same feed.
// @caller: admin (or timelock as contract caller)
// @params: n - new aggregation window (must be in [1, 100])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
pub fn set_aggregation_blocks(n: u64) -> u64 {
    only_admin()
    require(n >= 1 && n <= 100, "badval")
    Storage::new().store(AGGREGATION_BLOCKS_KEY, n)
    return 0
}

// ID 16: set_max_stale_blocks
// Update the staleness threshold (in blocks) after which a submission is dropped from aggregation.
// @caller: admin (or timelock as contract caller)
// @params: n - new staleness window (must be in [5, 500])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
pub fn set_max_stale_blocks(n: u64) -> u64 {
    only_admin()
    require(n >= 5 && n <= 500, "badval")
    Storage::new().store(MAX_STALE_BLOCKS_KEY, n)
    return 0
}

// ID 17: set_hard_stale_blocks
// Update the hard-stale threshold (in blocks) after which aggregated prices are no longer served to consumers.
// @caller: admin (or timelock as contract caller)
// @params: n - new hard-stale window (must be in [20, 500])
// @returns: 0 on success
// @security: only_admin, enforces bounded range; affects get_price_by_feed_impl
pub fn set_hard_stale_blocks(n: u64) -> u64 {
    only_admin()
    require(n >= 20 && n <= 500, "badval")
    Storage::new().store(HARD_STALE_BLOCKS_KEY, n)
    return 0
}

// ID 18: disable_bootstrap
// Switch the oracle out of bootstrap mode (which requires fewer providers) into full production mode.
// @caller: admin (or timelock as contract caller)
// @returns: 0 on success
// @security: only_admin; requires at least 20 active miners (cross-call to XelisVaultMiner ID 12); one-way transition
entry disable_bootstrap() -> u64 {
    only_admin()
    let mc: Contract = get_miner_contract()
    let active_count: u64 = mc.call(12u16, [], {})
    require(active_count >= 20, "need20providers")
    Storage::new().store(BOOTSTRAP_MODE_KEY, false)
    return 0
}

// ID 19: set_bootstrap_min_providers
// Update the minimum number of active miners required to serve prices while in bootstrap mode.
// @caller: admin (or timelock as contract caller)
// @params: n - new bootstrap min-providers threshold (must be in [1, 10])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
entry set_bootstrap_min_providers(n: u64) -> u64 {
    only_admin()
    require(n >= 1 && n <= 10, "badval")
    Storage::new().store(BOOTSTRAP_MIN_PROVIDERS_KEY, n)
    return 0
}

// ID 20: set_min_providers
// Update the minimum number of active miners required to serve prices in production (post-bootstrap) mode.
// @caller: admin (or timelock as contract caller)
// @params: n - new min-providers threshold (must be in [3, 100])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
entry set_min_providers(n: u64) -> u64 {
    only_admin()
    require(n >= 3 && n <= 100, "badval")
    Storage::new().store(MIN_PROVIDERS_FOR_ORACLE_KEY, n)
    return 0
}

// ID 21: set_miner_contract
// Set the XelisVaultMiner contract hash that this oracle cross-calls for miner verification / reward / slash.
// @caller: admin (or timelock as contract caller)
// @params: mc - hash of the XelisVaultMiner contract
// @returns: 0 on success
// @security: only_admin; misconfiguration would break every submit_price / aggregate
entry set_miner_contract(mc: Hash) -> u64 { only_admin() Storage::new().store(MINER_CONTRACT_KEY, mc) return 0 }

// v11.0: Set MinerDelegation contract (for total stake = own + delegated in oracle weight)
entry set_delegation_contract(dc: Hash) -> u64 { only_admin() Storage::new().store(DELEGATION_CONTRACT_KEY, dc) return 0 }

// ID 22: set_registry
// Set the registry hash (referenced by tooling / off-chain indexers).
// @caller: admin (or timelock as contract caller)
// @params: reg - new registry hash
// @returns: 0 on success
// @security: only_admin
entry set_registry(reg: Hash) -> u64 { only_admin() Storage::new().store(REGISTRY_KEY, reg) return 0 }

// ID 23: set_timelock
// Set the timelock contract hash that is allowed to invoke admin-gated entries as contract caller.
// @caller: admin (or existing timelock as contract caller)
// @params: tl - hash of the timelock contract
// @returns: 0 on success
// @security: only_admin
entry set_timelock(tl: Hash) -> u64 { only_admin() Storage::new().store(TIMELOCK_KEY, tl) return 0 }

// ID 24: set_guardian
// Set the guardian address able to pause the contract and trip feed circuit breakers.
// @caller: admin (or timelock as contract caller)
// @params: g - new guardian address
// @returns: 0 on success
// @security: only_admin
entry set_guardian(g: Address) -> u64 { only_admin() Storage::new().store(GUARDIAN_KEY, g) return 0 }

// ID 25: set_emergency
// Rotate the emergency-key holder (only the current emergency holder may do this).
// @caller: current emergency-key holder only
// @params: e - new emergency address
// @returns: 0 on success
// @security: caller must equal stored EMERGENCY_KEY (separate from admin auth)
entry set_emergency(e: Address) -> u64 {
    let s: Storage = Storage::new()
    let c: Address = get_caller().expect("nocaller")
    require(c == s.load(EMERGENCY_KEY).expect("easet"), "notemg")
    s.store(EMERGENCY_KEY, e)
    return 0
}

// ID 26: transfer_admin
// Transfer admin rights to a new address.
// @caller: admin (or timelock as contract caller)
// @params: new_admin - address of the new admin
// @returns: 0 on success
// @security: only_admin; immediate effect (no two-step confirmation in v5.1)
entry transfer_admin(new_admin: Address) -> u64 { only_admin() Storage::new().store(ADMIN_KEY, new_admin) return 0 }

// ID 27: get_version
// Return the contract version string.
// @caller: anyone (read-only)
// @returns: VERSION constant
// @security: read-only, no access control
entry get_version() -> string { return VERSION }

