// ============================================================================
// 0. CONSTRUCTOR
// ============================================================================
// Admin = deployer (signer of the deployment transaction). All parameters
// start at their documented defaults; the admin adjusts them with the
// set_* entries (range-checked against the hard caps, cross-checked in
// pairs — see SECURITY) and pins the LaunchDEX address (set_dex_address)
// before the first migration.
// ============================================================================
hook constructor() -> u64 {
    let s: Storage = Storage::new()

    let deployer: Address = Transaction::current().unwrap().source()
    s.store(ADMIN_KEY, deployer)

    s.store(COUNT_KEY, 0u64)
    s.store(SUBMISSION_FEE_KEY, DEFAULT_SUBMISSION_FEE)
    s.store(ASSET_BUDGET_KEY, DEFAULT_ASSET_BUDGET)
    s.store(MIN_LIQUIDITY_KEY, DEFAULT_MIN_LIQUIDITY)
    s.store(TRADING_FEE_KEY, DEFAULT_TRADING_FEE_BPS)
    s.store(GRADUATED_FEE_KEY, DEFAULT_GRADUATED_FEE_BPS)
    s.store(MIGRATION_FEE_KEY, DEFAULT_MIGRATION_FEE_BPS)
    s.store(DIRECT_LISTING_KEY, DEFAULT_DIRECT_LISTING)
    s.store(MIN_PARTICIPANTS_KEY, DEFAULT_MIN_PARTICIPANTS)
    s.store(MIN_APPROVAL_KEY, DEFAULT_MIN_APPROVAL_BPS)
    s.store(VALIDATION_DURATION_KEY, DEFAULT_VALIDATION_TOPO)
    s.store(GRAD_MULTIPLIER_KEY, DEFAULT_GRAD_MULTIPLIER)
    s.store(TEAM_DELAY_KEY, DEFAULT_TEAM_DELAY)
    s.store(VESTING_MIN_KEY, DEFAULT_VESTING_MIN)
    s.store(VESTING_MAX_KEY, DEFAULT_VESTING_MAX)
    s.store(RECOVERY_FEE_KEY, DEFAULT_RECOVERY_FEE)
    s.store(RECOVERY_PARTICIPANTS_KEY, DEFAULT_RECOVERY_PARTICIPANTS)
    s.store(RECOVERY_RATIO_KEY, DEFAULT_RECOVERY_RATIO_BPS)

    s.store(PENDING_FEES_KEY, 0u64)
    s.store(FEES_LIFETIME_KEY, 0u64)
    s.store(TOTAL_VOLUME_KEY, 0u64)
    s.store(TOTAL_CURVE_XEL_KEY, 0u64)
    s.store(LOCKED_REFUNDS_KEY, 0u64)
    s.store(TOTAL_BUY_VOL_KEY, 0u64)
    s.store(TOTAL_SELL_VOL_KEY, 0u64)
    s.store(TOTAL_TRADES_KEY, 0u64)
    s.store(TOTAL_BUDGETS_KEY, 0u64)
    s.store(MIGRATED_COUNT_KEY, 0u64)
    s.store(VOTE_DEPOSIT_KEY, DEFAULT_VOTE_DEPOSIT)
    s.store(VOTE_POTS_KEY, 0u64)
    s.store(PAUSED_KEY, false)

    s.store(XEL_ASSET_KEY, get_xelis_asset())

    return 0
}

// ============================================================================
// INTERNAL HELPERS
// ============================================================================

// 1. Access control — every admin entry funnels through this.
fn only_admin() {
    let s: Storage = Storage::new()
    let admin_opt: optional<Address> = s.load(ADMIN_KEY)
    require(admin_opt.is_some(), "noadmin")
    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let admin: Address = admin_opt.expect("guarded")
    let caller: Address = caller_opt.expect("guarded")
    require(caller == admin, "notauth")
}

// 2. Project existence — every project-scoped entry and view starts here.
fn require_project(pid: u64) {
    let count: u64 = Storage::new().load(COUNT_KEY).unwrap_or(0)
    require(pid < count, "noproj")
}

// 3. Storage key of a project field: "p:{id}:{field}".
fn proj_key(pid: u64, field: string) -> string {
    return PROJ_PREFIX + pid.to_string(10u32) + ":" + field
}

// 4. Storage key of a vote marker: "v:{id}:{round}:{addr}".
//    One key per (project, round, voter) — I5.
fn vote_key(pid: u64, round: u64, voter: Address) -> string {
    return VOTE_PREFIX + pid.to_string(10u32) + ":" + round.to_string(10u32) + ":" + voter.to_string()
}

// 5. Fee split — floor, in favour of the contract.
fn fee_take(amount: u64, bps: u64) -> u64 {
    let wide: u128 = (amount as u128) * (bps as u128) / (BPS_DENOM as u128)
    return wide as u64
}

// 6. Curve buy math: tokens out for a NET xel amount (fee already removed).
//    tokens_out = C * net / (R + net), floored. Always < C.
fn buy_tokens_out(reserves: u64, curve_supply: u64, net_xel: u64) -> u64 {
    let wide: u128 = (curve_supply as u128) * (net_xel as u128) / ((reserves as u128) + (net_xel as u128))
    return wide as u64
}

// 7. Curve sell math: XEL out (gross, before fee) for T tokens.
//    gross = R * T / (C + T), floored. Always < R.
fn sell_xel_out(reserves: u64, curve_supply: u64, tokens: u64) -> u64 {
    let wide: u128 = (reserves as u128) * (tokens as u128) / ((curve_supply as u128) + (tokens as u128))
    return wide as u64
}

// 8. Team allocation of a project (atomic token units), reserved in the
//    curve from day one, paid out via claim_team_allocation (I1, I4).
fn team_alloc_of(total_supply: u64, team_bps: u64) -> u64 {
    let wide: u128 = (total_supply as u128) * (team_bps as u128) / (BPS_DENOM as u128)
    return wide as u64
}

// 9. CHECKED ADD — u64 + u64 with an explicit overflow refusal (I9's
//    arithmetic backbone). The volume/fee/budget accumulators are the only
//    counters that grow without bound by design, so every addition on them
//    goes through this: unreachable in practice, guarded anyway — a
//    corrupted counter is worse than a refused trade.
fn checked_add(a: u64, b: u64) -> u64 {
    let wide: u128 = (a as u128) + (b as u128)
    require(wide <= U64_MAX_128, "ovf")
    return wide as u64
}

// 10. EFFECTIVE TRADING FEE (D8) — graduated projects trade at
//     graduated_fee_bps (the curve's post-graduation window, D15); bonding
//     projects at trading_fee_bps. The clamp guarantees graduated_fee <=
//     trading_fee even if storage were somehow inconsistent (defence in
//     depth on top of the cross-checked setters). Used by buy, sell AND
//     both quotes — a quote can never disagree with the trade it previews.
fn current_fee_bps(graduated: bool) -> u64 {
    let s: Storage = Storage::new()
    let bonding_fee: u64 = s.load(TRADING_FEE_KEY).unwrap_or(DEFAULT_TRADING_FEE_BPS)
    if !graduated {
        return bonding_fee
    }
    let graduated_fee: u64 = s.load(GRADUATED_FEE_KEY).unwrap_or(DEFAULT_GRADUATED_FEE_BPS)
    if graduated_fee > bonding_fee {
        return bonding_fee
    }
    return graduated_fee
}

// 11. Team allocation still owed to the creator: team_alloc - team_paid
//     (never negative — I4). This is the escrow the launchpad retains
//     after migration (I10).
fn team_remaining(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)
    let team_bps: u64 = s.load(proj_key(pid, F_TEAM_BPS)).unwrap_or(0)
    let team: u64 = team_alloc_of(total_supply, team_bps)
    let paid: u64 = s.load(proj_key(pid, F_TEAM_PAID)).unwrap_or(0)
    if paid >= team {
        return 0
    }
    return team - paid
}

// 12. TEAM UNLOCK AMOUNT (D3) — how much of the allocation the creator may
//     claim RIGHT NOW: the linear vesting stream if a vesting was started;
//     the full allocation once graduated (no vesting); the full allocation
//     for a never-graduated project after team_unlock_delay of bonding (the
//     anti-hostage late claim); zero otherwise. claim_team_allocation pays
//     unlocked - team_paid, so partial streams resume where they left off.
fn team_unlocked(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)
    let team_bps: u64 = s.load(proj_key(pid, F_TEAM_BPS)).unwrap_or(0)
    let team: u64 = team_alloc_of(total_supply, team_bps)
    if team == 0 {
        return 0
    }

    // Linear vesting stream — the creator's voluntary commitment (D3).
    let vesting_start: u64 = s.load(proj_key(pid, F_VESTING_START)).unwrap_or(0)
    if vesting_start > 0 {
        let duration: u64 = s.load(proj_key(pid, F_VESTING_DURATION)).unwrap_or(0)
        if duration == 0 {
            return team
        }
        let now: u64 = get_current_topoheight()
        if now <= vesting_start {
            return 0
        }
        let elapsed: u128 = (now - vesting_start) as u128
        let unlocked: u128 = (team as u128) * elapsed / (duration as u128)
        if unlocked >= (team as u128) {
            return team
        }
        return unlocked as u64
    }

    // Graduated (curve or direct listing): the migration reward (D3).
    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    if graduated {
        return team
    }

    // Never graduated but still alive after the unlock delay: the late
    // claim that keeps founders motivated (D3). Rejected/Validation
    // projects return 0 — a rejected launch never pays team tokens.
    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    if status == ST_BONDING || status == ST_UNTRUSTED || status == ST_RECOVERY {
        let bonding_start: u64 = s.load(proj_key(pid, F_BONDING_START)).unwrap_or(0)
        let delay: u64 = s.load(TEAM_DELAY_KEY).unwrap_or(DEFAULT_TEAM_DELAY)
        if bonding_start > 0 {
            if (get_current_topoheight() as u128) >= (bonding_start as u128) + (delay as u128) {
                return team
            }
        }
    }
    return 0
}

// 13. TRUST GUARD — evaluated after every vote on a project that already
//     trades (Bonding / Graduated / Trusted). When reports reach the loss
//     threshold (same bar as validation: quorum + ratio), the project flips
//     to Untrusted: buys blocked (curve directly; pool after sync — D17),
//     sells and votes stay open (D4).
fn trust_guard(pid: u64, status: u64) {
    if status == ST_BONDING || status == ST_GRADUATED || status == ST_TRUSTED {
        let s: Storage = Storage::new()
        let supports: u64 = s.load(proj_key(pid, F_SUPPORTS)).unwrap_or(0)
        let reports: u64 = s.load(proj_key(pid, F_REPORTS)).unwrap_or(0)
        let total: u64 = supports + reports
        let min_p: u64 = s.load(MIN_PARTICIPANTS_KEY).unwrap_or(DEFAULT_MIN_PARTICIPANTS)
        let ratio: u64 = s.load(MIN_APPROVAL_KEY).unwrap_or(DEFAULT_MIN_APPROVAL_BPS)
        if total >= min_p {
            if (reports as u128) * 10000u128 >= (ratio as u128) * (total as u128) {
                s.store(proj_key(pid, F_STATUS), ST_UNTRUSTED)
                emit_event(EV_TRUST_LOST, [pid.to_string(10u32), reports.to_string(10u32), supports.to_string(10u32)])
            }
        }
    }
}

// 14. MIGRATION FEE (D9) — taken ONCE per project, at graduation (both
//     paths, via graduate()). fee = fee_take(reserves, migration_fee_bps)
//     leaves the curve's reserves (and total_curve_xel with it — D20) and
//     accrues to pending_fees. The XEL commitment identity is untouched:
//     the fee moves from the curve side to the fees side of I2's RHS.
//     No-op when the fee rate is zero.
fn take_migration_fee(pid: u64) {
    let s: Storage = Storage::new()
    let bps: u64 = s.load(MIGRATION_FEE_KEY).unwrap_or(DEFAULT_MIGRATION_FEE_BPS)
    if bps == 0 {
        return
    }
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let fee: u64 = fee_take(reserves, bps)
    if fee == 0 {
        return
    }
    require(reserves >= fee, "curverr")
    s.store(proj_key(pid, F_RESERVES), reserves - fee)
    let curve_xel: u64 = s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0)
    require(curve_xel >= fee, "accerr")
    s.store(TOTAL_CURVE_XEL_KEY, curve_xel - fee)
    let pending: u64 = s.load(PENDING_FEES_KEY).unwrap_or(0)
    s.store(PENDING_FEES_KEY, checked_add(pending, fee))
    emit_event(EV_MIGRATION_FEE, [pid.to_string(10u32), fee.to_string(10u32)])
}

// 15. UPDATE MARKET CAP (D12) — recompute the spot market cap from the
//     curve's live state (same formula as the pure get_market_cap view) and
//     STORE it: mc = current spot, mh = all-time high (monotone). Idempotent
//     by construction. Post-migration the curve is closed (curve_supply 0)
//     and mc freezes at 0 — the live cap moves to the DEX era (D12).
fn update_market_cap(pid: u64) {
    let s: Storage = Storage::new()
    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    let cap: u64 = 0
    if curve_supply > 0 {
        let team_rem: u128 = team_remaining(pid) as u128
        let circulating: u128 = (total_supply as u128) - (curve_supply as u128) - team_rem
        if circulating > 0 {
            let wide: u128 = (reserves as u128) * circulating / (curve_supply as u128)
            if wide <= U64_MAX_128 {
                cap = wide as u64
            } else {
                cap = U64_MAX
            }
        }
    }
    s.store(proj_key(pid, F_MCAP), cap)
    let high: u64 = s.load(proj_key(pid, F_MCAP_HIGH)).unwrap_or(0)
    if cap > high {
        s.store(proj_key(pid, F_MCAP_HIGH), cap)
    }
}

// 16. RECORD TRADE (D12) — the single funnel through which every curve
//     buy/sell updates the scoreboard, so the volume identity (I9) holds by
//     construction. Buy side records the ATTACHED amount (fee included);
//     sell side records the PRE-FEE gross out.
fn record_trade(pid: u64, buy_side: bool, xel_amount: u64) {
    let s: Storage = Storage::new()
    if buy_side {
        let bv: u64 = s.load(proj_key(pid, F_BUY_VOL)).unwrap_or(0)
        s.store(proj_key(pid, F_BUY_VOL), checked_add(bv, xel_amount))
        let tbv: u64 = s.load(TOTAL_BUY_VOL_KEY).unwrap_or(0)
        s.store(TOTAL_BUY_VOL_KEY, checked_add(tbv, xel_amount))
    } else {
        let sv: u64 = s.load(proj_key(pid, F_SELL_VOL)).unwrap_or(0)
        s.store(proj_key(pid, F_SELL_VOL), checked_add(sv, xel_amount))
        let tsv: u64 = s.load(TOTAL_SELL_VOL_KEY).unwrap_or(0)
        s.store(TOTAL_SELL_VOL_KEY, checked_add(tsv, xel_amount))
    }
    let vo: u64 = s.load(proj_key(pid, F_VOLUME)).unwrap_or(0)
    s.store(proj_key(pid, F_VOLUME), checked_add(vo, xel_amount))
    let tvl: u64 = s.load(TOTAL_VOLUME_KEY).unwrap_or(0)
    s.store(TOTAL_VOLUME_KEY, checked_add(tvl, xel_amount))
    let tc: u64 = s.load(proj_key(pid, F_TRADES)).unwrap_or(0)
    s.store(proj_key(pid, F_TRADES), checked_add(tc, 1))
    let ttc: u64 = s.load(TOTAL_TRADES_KEY).unwrap_or(0)
    s.store(TOTAL_TRADES_KEY, checked_add(ttc, 1))
    s.store(proj_key(pid, F_LAST_TRADE), get_current_topoheight())
}

// 17. GRADUATE — flips a trading project to Graduated (the milestone), then
//     takes the one-time migration fee from the curve (D9), BINDS the
//     declared vesting plan if there is one (D10), and snapshots the
//     graduation market cap (D12). Team tokens are NOT sent here: they
//     stay in the escrow (I10) and become claimable (immediately, or
//     through the plan's linear stream) via claim_team_allocation (D3).
//     Funds are NOT moved either: the curve keeps trading at the graduated
//     fee (D8) until the permissionless migrate() moves everything to the
//     LaunchDEX pool (D15). Called from buy() when the curve crossed the
//     graduation threshold, and from finalize_validation() for a direct
//     listing (both paths converge here — one set of post-graduation
//     rules).
fn graduate(pid: u64) {
    let s: Storage = Storage::new()

    s.store(proj_key(pid, F_STATUS), ST_GRADUATED)
    s.store(proj_key(pid, F_GRADUATED), true)

    take_migration_fee(pid)

    // D10 — bind the declared vesting plan: the community voted on this
    // exact schedule; graduate() is where it becomes real. Irreversible by
    // design (start_team_vesting refuses planned projects afterwards).
    let plan: u64 = s.load(proj_key(pid, F_VESTING_PLAN)).unwrap_or(0)
    if plan > 0 {
        s.store(proj_key(pid, F_VESTING_START), get_current_topoheight())
        s.store(proj_key(pid, F_VESTING_DURATION), plan)
        emit_event(EV_TEAM_VESTING_STARTED, [pid.to_string(10u32), plan.to_string(10u32)])
    }

    // D12 — the milestone number: market cap recomputed AFTER the migration
    // fee (the honest post-graduation state), stored as the graduation cap.
    update_market_cap(pid)
    let cap: u64 = s.load(proj_key(pid, F_MCAP)).unwrap_or(0)
    s.store(proj_key(pid, F_MCAP_GRAD), cap)

    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)
    let team_bps: u64 = s.load(proj_key(pid, F_TEAM_BPS)).unwrap_or(0)
    let team: u64 = team_alloc_of(total_supply, team_bps)
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    emit_event(EV_PROJECT_GRADUATED, [pid.to_string(10u32), reserves.to_string(10u32), team.to_string(10u32)])
}

// 18. CREATE PROJECT ASSET (D13) — the real token is born. Called by
//     finalize_validation on a PASSED vote, BEFORE any state flip (a
//     failed creation reverts the whole finalize: the project stays in
//     Validation and can be finalized again — e.g. with a budget top-up).
//
//     Asset::create with MaxSupplyMode::Fixed: the ENTIRE supply is minted
//     to this contract at creation and can never be increased — the max
//     cap is enforced by the XELIS protocol itself. The chain's asset
//     creation cost is measured by balance-delta (robust to any fee
//     change), paid from the project's earmarked budget (collected at
//     propose) plus any top-up attached to the finalize transaction, and
//     the unused part is refunded to the creator on the spot.
fn create_project_asset(pid: u64) {
    let s: Storage = Storage::new()

    // The asset is created exactly once per project (finalize only runs on
    // a Validation/Recovery pass, and the asset slot is write-once).
    require(s.load(proj_key(pid, F_ASSET)).is_none(), "exists")

    let name: string = s.load(proj_key(pid, F_NAME)).unwrap_or("")
    let symbol: string = s.load(proj_key(pid, F_SYMBOL)).unwrap_or("")
    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)

    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let topup: u64 = get_deposit_for_asset(xel).unwrap_or(0)

    // Measure the protocol's creation fee by balance-delta. The deposit
    // (if any) is already credited, so the delta isolates exactly what
    // Asset::create charged.
    let bal_before: u64 = get_balance_for_asset(xel).unwrap_or(0)

    let asset_opt: optional<Asset> = Asset::create(
        pid,
        name,
        symbol,
        TOKEN_DECIMALS,
        MaxSupplyMode::Fixed { max_supply: total_supply }
    )
    require(asset_opt.is_some(), "assetcr")
    let asset: Asset = asset_opt.expect("guarded")
    let hash: Hash = asset.get_hash()

    let bal_after: u64 = get_balance_for_asset(xel).unwrap_or(0)
    require(bal_before >= bal_after, "accerr")
    let fee_paid: u64 = bal_before - bal_after

    // D13's safety check: Fixed mode must have delivered the WHOLE supply
    // to this contract. Anything less reverts the finalize.
    let tok_bal: u64 = get_balance_for_asset(hash).unwrap_or(0)
    require(tok_bal == total_supply, "assetbal")

    // Budget accounting: earmark + top-up must cover the fee; the unused
    // part goes back to the creator immediately.
    let budget: u64 = s.load(proj_key(pid, F_BUDGET)).unwrap_or(0)
    let avail: u64 = checked_add(budget, topup)
    require(avail >= fee_paid, "budget")

    s.store(proj_key(pid, F_BUDGET), 0u64)
    if budget > 0 {
        let tbb: u64 = s.load(TOTAL_BUDGETS_KEY).unwrap_or(0)
        require(tbb >= budget, "accerr")
        s.store(TOTAL_BUDGETS_KEY, tbb - budget)
    }

    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    require(creator_opt.is_some(), "nocr")
    let creator: Address = creator_opt.expect("guarded")

    let refund: u64 = avail - fee_paid
    if refund > 0 {
        let ok: bool = transfer(creator, refund, xel)
        require(ok, "txfail")
    }

    s.store(proj_key(pid, F_ASSET), hash)
    // D22 — the reverse bridge: asset hash -> project id, written once at
    // creation. The DEX enumerates pools by ASSET; this maps them back to
    // the launchpad's project pages (get_project_by_asset).
    s.store(ASSET_LOOKUP_PREFIX + hash.to_hex(), pid)
    emit_event(EV_ASSET_CREATED, [pid.to_string(10u32), hash.to_hex(), fee_paid.to_string(10u32)])
}

// 19. MIGRATE TO DEX (D15, internal) — the atomic move. Takes the curve's
//     whole XEL reserves and its whole token inventory (team escrow
//     excepted — I10) and seeds a permanent LaunchDEX pool with them via
//     ONE cross-contract call carrying both amounts as attached deposits.
//     Everything (state flips, global accounting, the deposits, the pool
//     creation) is one transaction: a failure anywhere reverts it all.
//     If the project is Untrusted at migration time, the pool's buys are
//     paused in the SAME transaction (D17 — no unprotected window).
fn migrate_to_dex(pid: u64) {
    let s: Storage = Storage::new()

    let dex_opt: optional<Hash> = s.load(DEX_ADDRESS_KEY)
    require(dex_opt.is_some(), "nodex")
    let dex: Hash = dex_opt.expect("guarded")

    let asset_opt: optional<Hash> = s.load(proj_key(pid, F_ASSET))
    require(asset_opt.is_some(), "noasset")
    let asset: Hash = asset_opt.expect("guarded")

    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    require(reserves >= 1 && curve_supply >= 1, "empty")

    // Belt-and-braces solvency (I2/I10 guarantee these; refuse loudly if
    // accounting ever disagrees — a broken migration is better than a
    // short one).
    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let xel_bal: u64 = get_balance_for_asset(xel).unwrap_or(0)
    require(reserves <= xel_bal, "accerr")
    let tok_bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    let team_rem: u64 = team_remaining(pid)
    require((curve_supply as u128) + (team_rem as u128) <= (tok_bal as u128), "accerr")

    // STATE FIRST (atomic with the call below): close the curve, snapshot
    // what is being sent, update the global XEL accounting (D20).
    s.store(proj_key(pid, F_MIGRATED), true)
    s.store(proj_key(pid, F_MIG_AT), get_current_topoheight())
    s.store(proj_key(pid, F_MIG_XEL), reserves)
    s.store(proj_key(pid, F_MIG_TOK), curve_supply)
    s.store(proj_key(pid, F_RESERVES), 0u64)
    s.store(proj_key(pid, F_CURVE), 0u64)

    let curve_xel: u64 = s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0)
    require(curve_xel >= reserves, "accerr")
    s.store(TOTAL_CURVE_XEL_KEY, curve_xel - reserves)

    let migrated_count: u64 = s.load(MIGRATED_COUNT_KEY).unwrap_or(0)
    s.store(MIGRATED_COUNT_KEY, checked_add(migrated_count, 1))
    // D22 — the migrated index: m:{order} -> pid, written once per
    // migration (enumerate with get_migrated_count / get_migrated_by_rank;
    // works across DEX generations since it lives on the launchpad side).
    s.store(MIGRATED_INDEX_PREFIX + migrated_count.to_string(10u32), pid)

    update_market_cap(pid)

    // Permission precheck (clear refusal for wallets that did not grant
    // the contract-call permission on this transaction).
    require(is_contract_callable(dex, DEX_CREATE_POOL_CHUNK), "txperm")

    let target_opt: optional<Contract> = Contract::new(dex)
    require(target_opt.is_some(), "dexgone")
    let target: Contract = target_opt.expect("guarded")

    // The deposits carry BOTH sides of the seed; the DEX reads exactly
    // what arrived (single source of truth).
    let deposits: map<Hash, u64> = {}
    deposits.insert(xel, reserves)
    deposits.insert(asset, curve_supply)
    target.call(DEX_CREATE_POOL_CHUNK, [asset], deposits)

    // Untrusted at migration time: pause the pool's buys in the SAME
    // transaction (D17). Sells stay open on both venues, always (D4).
    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    if status == ST_UNTRUSTED {
        require(is_contract_callable(dex, DEX_SET_PAUSED_CHUNK), "txperm")
        target.call(DEX_SET_PAUSED_CHUNK, [asset, true], {})
        s.store(proj_key(pid, F_DEX_SYNCED), true)
    }
}
// ============================================================================
// 20. PROPOSE — submit a project to the community filter.
// ============================================================================
// @caller: the project creator (a wallet).
// @params: name, symbol, description, website, logo, twitter, telegram,
//             discord — display metadata (length-capped; social links may be
//             empty = "no link"; the team can update description, website,
//             logo AND socials at any time via update_project_info — D11);
//          total_supply — the token's FIXED supply in atomic units
//             (8 decimals), capped to [MIN_TOTAL_SUPPLY, MAX_TOTAL_SUPPLY].
//             This is the asset's max_supply at creation (D13): the WHOLE
//             supply is minted to the contract at validation success and
//             NOTHING can ever be minted past it;
//          team_bps — team allocation in basis points, <= 20%;
//          vesting_duration — the TEAM VESTING PLAN (D10): 0 = claim at
//             graduation, any value inside [vesting_min, vesting_max]
//             (SNAPSHOTTED NOW) is a declared plan that graduate() will
//             BIND automatically.
// @attached: EXACTLY submission_fee + asset_budget + the founder's
//             liquidity, where liquidity is >= min_liquidity and <=
//             MAX_LIQUIDITY. The fee joins pending_fees immediately
//             (non-refundable); the budget is EARMARKED for the chain's
//             asset creation cost (D13 — unused part refunded at creation,
//             or with the refund on rejection); the liquidity is locked as
//             the curve's seed reserves.
// @returns: the project id.
// @direct listing (D7): if the locked liquidity >= direct_listing_threshold
//             (SNAPSHOTTED NOW), the project is flagged to graduate the
//             moment validation passes.
// @ticker registry (D11): the symbol is reserved launchpad-wide at propose
//             time — first project wins it, forever (chain-wide, XELIS
//             tickers are self-declared; this registry keeps OUR listings
//             unambiguous).
// @security: paused check, capacity check, metadata caps, supply/team caps,
//            plan bounds snapshot, ticker reservation, deposit lower bound,
//            everything stored under fresh keys (the ticker registry key is
//            built from a length-capped symbol in a dedicated "t:" namespace).
// ============================================================================
entry propose(name: string, symbol: string, description: string, website: string, logo: string, twitter: string, telegram: string, discord: string, total_supply: u64, team_bps: u64, vesting_duration: u64) -> u64 {
    let s: Storage = Storage::new()
    require(s.load(PAUSED_KEY).unwrap_or(false) == false, "paused")

    let count: u64 = s.load(COUNT_KEY).unwrap_or(0)
    require(count < MAX_PROJECTS, "full")

    // Metadata caps (social links are display metadata, same rules — D11).
    require(name.len() >= 1u32 && name.len() <= MAX_NAME_LEN, "badname")
    require(symbol.len() >= 1u32 && symbol.len() <= MAX_SYMBOL_LEN, "badsym")
    require(description.len() <= MAX_DESC_LEN, "baddesc")
    require(website.len() <= MAX_URL_LEN, "badurl")
    require(logo.len() <= MAX_URL_LEN, "badlogo")
    require(twitter.len() <= MAX_URL_LEN, "badtw")
    require(telegram.len() <= MAX_URL_LEN, "badtg")
    require(discord.len() <= MAX_URL_LEN, "baddc")

    // Ticker reservation (D11): one launchpad project per symbol, forever.
    let ticker_key: string = TICKER_PREFIX + symbol
    require(s.load(ticker_key).is_none(), "tick")

    // Tokenomics caps.
    require(total_supply >= MIN_TOTAL_SUPPLY && total_supply <= MAX_TOTAL_SUPPLY, "badsupply")
    require(team_bps <= MAX_TEAM_BPS, "badteam")

    // Vesting plan (D10): 0 = immediate claim at graduation; otherwise it
    // must fit the admin-bounded window SNAPSHOTTED at propose time — the
    // founder gets the rules they signed up for, the community gets a plan
    // that can only be honoured, never re-tuned.
    let plan_min: u64 = s.load(VESTING_MIN_KEY).unwrap_or(DEFAULT_VESTING_MIN)
    let plan_max: u64 = s.load(VESTING_MAX_KEY).unwrap_or(DEFAULT_VESTING_MAX)
    require(vesting_duration == 0 || (vesting_duration >= plan_min && vesting_duration <= plan_max), "badplan")

    // Funds: fee (to the admin) + asset budget (earmarked, D13) + seed
    // liquidity (locked in the curve).
    let sub_fee: u64 = s.load(SUBMISSION_FEE_KEY).unwrap_or(DEFAULT_SUBMISSION_FEE)
    let budget: u64 = s.load(ASSET_BUDGET_KEY).unwrap_or(DEFAULT_ASSET_BUDGET)
    let min_liq: u64 = s.load(MIN_LIQUIDITY_KEY).unwrap_or(DEFAULT_MIN_LIQUIDITY)
    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let dep: u64 = get_deposit_for_asset(xel).unwrap_or(0)
    require(dep >= sub_fee + budget + min_liq, "needliq")
    let liquidity: u64 = dep - sub_fee - budget
    require(liquidity <= MAX_LIQUIDITY, "toobig")

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let pid: u64 = count
    s.store(proj_key(pid, F_CREATOR), caller)
    s.store(proj_key(pid, F_STATUS), ST_VALIDATION)
    s.store(proj_key(pid, F_NAME), name)
    s.store(proj_key(pid, F_SYMBOL), symbol)
    s.store(proj_key(pid, F_DESC), description)
    s.store(proj_key(pid, F_WEBSITE), website)
    s.store(proj_key(pid, F_LOGO), logo)
    s.store(proj_key(pid, F_TWITTER), twitter)
    s.store(proj_key(pid, F_TELEGRAM), telegram)
    s.store(proj_key(pid, F_DISCORD), discord)
    s.store(proj_key(pid, F_SUPPLY), total_supply)
    s.store(proj_key(pid, F_TEAM_BPS), team_bps)
    s.store(proj_key(pid, F_LIQUIDITY), liquidity)
    s.store(proj_key(pid, F_BUDGET), budget)

    // Curve opening state: reserves = seed liquidity; the curve's sellable
    // supply EXCLUDES the team allocation (reserved until claimed — D3).
    s.store(proj_key(pid, F_RESERVES), liquidity)
    s.store(proj_key(pid, F_CURVE), total_supply - team_alloc_of(total_supply, team_bps))

    // D20: the seed joins the global curve accounting (exact-sum model).
    s.store(TOTAL_CURVE_XEL_KEY, checked_add(s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0), liquidity))
    s.store(TOTAL_BUDGETS_KEY, checked_add(s.load(TOTAL_BUDGETS_KEY).unwrap_or(0), budget))

    // Two-path snapshot (D7): big liquidity graduates directly at
    // validation success; the threshold is read ONCE, here.
    let threshold: u64 = s.load(DIRECT_LISTING_KEY).unwrap_or(DEFAULT_DIRECT_LISTING)
    s.store(proj_key(pid, F_DL), liquidity >= threshold)

    // Team-claim bookkeeping (D3, D10): the declared plan rides along until
    // graduate() binds it; vs/vd stay 0 until then (or until a voluntary
    // start_team_vesting on an unplanned project).
    s.store(proj_key(pid, F_TEAM_PAID), 0u64)
    s.store(proj_key(pid, F_VESTING_START), 0u64)
    s.store(proj_key(pid, F_VESTING_DURATION), 0u64)
    s.store(proj_key(pid, F_VESTING_PLAN), vesting_duration)
    s.store(proj_key(pid, F_BONDING_START), 0u64)

    // Migration bookkeeping (D15/D17): nothing migrated, nothing synced.
    s.store(proj_key(pid, F_MIGRATED), false)
    s.store(proj_key(pid, F_MIG_AT), 0u64)
    s.store(proj_key(pid, F_MIG_XEL), 0u64)
    s.store(proj_key(pid, F_MIG_TOK), 0u64)
    s.store(proj_key(pid, F_DEX_SYNCED), false)

    // Voting round 0 opens now.
    s.store(proj_key(pid, F_ROUND), 0u64)
    s.store(proj_key(pid, F_SUPPORTS), 0u64)
    s.store(proj_key(pid, F_REPORTS), 0u64)
    s.store(proj_key(pid, F_CREATED), get_current_topoheight())
    let duration: u64 = s.load(VALIDATION_DURATION_KEY).unwrap_or(DEFAULT_VALIDATION_TOPO)
    s.store(proj_key(pid, F_DEADLINE), get_current_topoheight() + duration)

    s.store(proj_key(pid, F_GRADUATED), false)
    s.store(proj_key(pid, F_REFUND), false)
    s.store(proj_key(pid, F_VOLUME), 0u64)

    // Trading-data scoreboard (D12): starts empty, filled by every trade.
    s.store(proj_key(pid, F_BUY_VOL), 0u64)
    s.store(proj_key(pid, F_SELL_VOL), 0u64)
    s.store(proj_key(pid, F_TRADES), 0u64)
    s.store(proj_key(pid, F_LAST_TRADE), 0u64)
    s.store(proj_key(pid, F_MCAP), 0u64)
    s.store(proj_key(pid, F_MCAP_HIGH), 0u64)
    s.store(proj_key(pid, F_MCAP_GRAD), 0u64)

    s.store(COUNT_KEY, pid + 1)
    s.store(ticker_key, pid)

    if sub_fee > 0 {
        let pending: u64 = s.load(PENDING_FEES_KEY).unwrap_or(0)
        s.store(PENDING_FEES_KEY, checked_add(pending, sub_fee))
    }

    emit_event(EV_PROJECT_CREATED, [pid.to_string(10u32), name, symbol, liquidity.to_string(10u32)])
    return pid
}

// ============================================================================
// 21. SUPPORT — vote FOR a project (validation round or ongoing trust).
// ============================================================================
// One vote per address per round (I5). During an open validation window the
// vote counts towards the pass threshold; afterwards it keeps accumulating
// in the project's trust tallies (trust_guard evaluates the flip).
// 1 address = 1 vote per round (D6). With the D21 dial raised, a vote also
// LOCKS the configured vote_deposit XEL (any excess attached is refunded
// immediately; the deposit itself is refunded by claim_vote_deposit once
// the round has closed). Voting stays free while the dial reads 0 (the
// default) — and even then, any XEL mistakenly attached to a vote is
// returned to the caller in the same transaction: a vote never keeps more
// than the configured deposit.
// ============================================================================
entry support(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status != ST_REJECTED, "dead")
    if status == ST_VALIDATION || status == ST_RECOVERY {
        let deadline: u64 = s.load(proj_key(pid, F_DEADLINE)).unwrap_or(0)
        require(get_current_topoheight() < deadline, "ended")
    }

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let round: u64 = s.load(proj_key(pid, F_ROUND)).unwrap_or(0)
    let vkey: string = vote_key(pid, round, caller)
    require(s.load(vkey).is_none(), "voted")

    // D21 — lock exactly the configured deposit, refund any excess now.
    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let vdep: u64 = s.load(VOTE_DEPOSIT_KEY).unwrap_or(DEFAULT_VOTE_DEPOSIT)
    let dep: u64 = get_deposit_for_asset(xel).unwrap_or(0)
    require(dep >= vdep, "votedep")
    let back: u64 = dep - vdep
    // The vote slot records the LOCKED amount (I5: is_some() is the marker).
    s.store(vkey, vdep)
    if vdep > 0 {
        let pots: u64 = s.load(VOTE_POTS_KEY).unwrap_or(0)
        s.store(VOTE_POTS_KEY, checked_add(pots, vdep))
    }

    let tally: u64 = s.load(proj_key(pid, F_SUPPORTS)).unwrap_or(0)
    s.store(proj_key(pid, F_SUPPORTS), tally + 1)

    // State first, transfer last (the excess is the voter's own fresh
    // deposit — it can never touch committed funds).
    if back > 0 {
        let ok: bool = transfer(caller, back, xel)
        require(ok, "txfail")
    }

    emit_event(EV_SUPPORTED, [pid.to_string(10u32), round.to_string(10u32), caller.to_string()])
    trust_guard(pid, status)
    return tally + 1
}

// ============================================================================
// 22. REPORT — vote AGAINST a project (validation round or ongoing trust).
// ============================================================================
// Mirror of support() — same D21 deposit rules (a report costs the same as
// a support: the dial cannot be dodged by voting against). Enough reports
// on a trading project flip it to Untrusted (buys blocked on the curve
// directly and — once synced — on the pool; sells open everywhere —
// D4/D17).
// ============================================================================
entry report(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status != ST_REJECTED, "dead")
    if status == ST_VALIDATION || status == ST_RECOVERY {
        let deadline: u64 = s.load(proj_key(pid, F_DEADLINE)).unwrap_or(0)
        require(get_current_topoheight() < deadline, "ended")
    }

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let round: u64 = s.load(proj_key(pid, F_ROUND)).unwrap_or(0)
    let vkey: string = vote_key(pid, round, caller)
    require(s.load(vkey).is_none(), "voted")

    // D21 — same deposit rules as support().
    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let vdep: u64 = s.load(VOTE_DEPOSIT_KEY).unwrap_or(DEFAULT_VOTE_DEPOSIT)
    let dep: u64 = get_deposit_for_asset(xel).unwrap_or(0)
    require(dep >= vdep, "votedep")
    let back: u64 = dep - vdep
    s.store(vkey, vdep)
    if vdep > 0 {
        let pots: u64 = s.load(VOTE_POTS_KEY).unwrap_or(0)
        s.store(VOTE_POTS_KEY, checked_add(pots, vdep))
    }

    let tally: u64 = s.load(proj_key(pid, F_REPORTS)).unwrap_or(0)
    s.store(proj_key(pid, F_REPORTS), tally + 1)

    if back > 0 {
        let ok: bool = transfer(caller, back, xel)
        require(ok, "txfail")
    }

    emit_event(EV_REPORTED, [pid.to_string(10u32), round.to_string(10u32), caller.to_string()])
    trust_guard(pid, status)
    return tally + 1
}

// ============================================================================
// 23. FINALIZE VALIDATION — apply the outcome of a closed voting window.
// ============================================================================
// @caller: ANYONE, after the window's deadline (permissionless finalizer —
//          the outcome is fully determined by the public tallies, this only
//          executes it; the founder has a natural incentive to call it for
//          a refund on failure, the community on success).
// @attached (optional): a XEL top-up for the asset budget (D13) — only
//          useful if the chain's asset creation cost rose above the
//          earmarked budget between propose and finalize; the unused part
//          of budget + top-up is refunded to the creator in the same
//          transaction.
// @rules:  initial window  : pass >= min_participants voters AND >= 80%
//                             support -> [D13] Asset::create (the REAL
//                             token is born; failure reverts everything),
//                             then Bonding, OR direct listing when the
//                             proposal locked >= the threshold (D7):
//                             graduation on the spot (migration fee taken,
//                             pool seedable the same block via migrate).
//                             Fail -> Rejected (liquidity + asset budget
//                             become refundable once).
//          recovery window : graduated projects use the STRICTER recovery
//                             thresholds; pass -> Trusted, fail -> Untrusted
// ============================================================================
entry finalize_validation(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status == ST_VALIDATION || status == ST_RECOVERY, "nowindow")
    let deadline: u64 = s.load(proj_key(pid, F_DEADLINE)).unwrap_or(0)
    require(get_current_topoheight() >= deadline, "open")

    let supports: u64 = s.load(proj_key(pid, F_SUPPORTS)).unwrap_or(0)
    let reports: u64 = s.load(proj_key(pid, F_REPORTS)).unwrap_or(0)
    let total: u64 = supports + reports

    if status == ST_VALIDATION {
        let min_p: u64 = s.load(MIN_PARTICIPANTS_KEY).unwrap_or(DEFAULT_MIN_PARTICIPANTS)
        let ratio: u64 = s.load(MIN_APPROVAL_KEY).unwrap_or(DEFAULT_MIN_APPROVAL_BPS)
        if total >= min_p && (supports as u128) * 10000u128 >= (ratio as u128) * (total as u128) {
            // The REAL token is born HERE (D13) — before any state flip, so
            // a failed creation (budget overrun, chain refusal) leaves the
            // project untouched in Validation, retryable with a top-up.
            create_project_asset(pid)

            // Trading starts now, one way or the other.
            s.store(proj_key(pid, F_BONDING_START), get_current_topoheight())
            let dl: bool = s.load(proj_key(pid, F_DL)).unwrap_or(false)
            if dl {
                // Direct listing (D7): serious liquidity skips the bonding
                // phase — graduation (and its advantages) on day one. The
                // pool can be seeded the same block via migrate(pid).
                graduate(pid)
                let liquidity: u64 = s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0)
                emit_event(EV_VALIDATION_FINISHED, [pid.to_string(10u32), "1"])
                emit_event(EV_DIRECT_LISTED, [pid.to_string(10u32), liquidity.to_string(10u32)])
            } else {
                s.store(proj_key(pid, F_STATUS), ST_BONDING)
                emit_event(EV_VALIDATION_FINISHED, [pid.to_string(10u32), "1"])
                emit_event(EV_BONDING_OPENED, [pid.to_string(10u32)])
            }
            return 1
        }
        s.store(proj_key(pid, F_STATUS), ST_REJECTED)
        let liquidity: u64 = s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0)
        let budget: u64 = s.load(proj_key(pid, F_BUDGET)).unwrap_or(0)
        let locked: u64 = s.load(LOCKED_REFUNDS_KEY).unwrap_or(0)
        s.store(LOCKED_REFUNDS_KEY, checked_add(locked, liquidity))
        // D20: the rejected curve's seed leaves the live-reserve sum (it is
        // now a refund-in-waiting); the budget stays earmarked until the
        // refund is claimed.
        let curve_xel: u64 = s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0)
        require(curve_xel >= liquidity, "accerr")
        s.store(TOTAL_CURVE_XEL_KEY, curve_xel - liquidity)
        s.store(proj_key(pid, F_RESERVES), 0u64)
        emit_event(EV_VALIDATION_FINISHED, [pid.to_string(10u32), "0"])
        return 0
    }

    // Recovery window: stricter bar for graduated projects (D-lifecycle).
    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    let min_p: u64 = s.load(MIN_PARTICIPANTS_KEY).unwrap_or(DEFAULT_MIN_PARTICIPANTS)
    let ratio: u64 = s.load(MIN_APPROVAL_KEY).unwrap_or(DEFAULT_MIN_APPROVAL_BPS)
    if graduated {
        min_p = s.load(RECOVERY_PARTICIPANTS_KEY).unwrap_or(DEFAULT_RECOVERY_PARTICIPANTS)
        ratio = s.load(RECOVERY_RATIO_KEY).unwrap_or(DEFAULT_RECOVERY_RATIO_BPS)
    }
    if total >= min_p && (supports as u128) * 10000u128 >= (ratio as u128) * (total as u128) {
        if graduated {
            s.store(proj_key(pid, F_STATUS), ST_TRUSTED)
        } else {
            s.store(proj_key(pid, F_STATUS), ST_BONDING)
        }
        emit_event(EV_TRUST_RECOVERED, [pid.to_string(10u32)])
        return 1
    }
    s.store(proj_key(pid, F_STATUS), ST_UNTRUSTED)
    emit_event(EV_VALIDATION_FINISHED, [pid.to_string(10u32), "0"])
    return 0
}

// ============================================================================
// 24. BUY — trade XEL for REAL tokens on a project's curve (D14).
// ============================================================================
// @caller: anyone (a wallet). Blocked while paused, while the project is
//          Untrusted or in a voting window (D4), and after migration (the
//          curve is closed — buy on the DEX, D15) — the ONLY ways curve
//          buys stop.
// @attached: XEL in [MIN_BUY_XEL, MAX_TRADE_XEL]. The trading fee (bonding
//            or graduated rate, D8) goes to pending_fees; the NET amount
//            joins the reserves; tokens out follow the constant-product
//            formula (floored, u128 math) and are TRANSFERRED to the
//            caller's wallet — a native confidential transfer of a real
//            XELIS asset (D1/D18).
// @returns: tokens received (atomic units), already in the caller's wallet.
// @graduation: if this buy pushes the reserves to
//              liquidity * graduation_multiplier while Bonding, the project
//              graduates (status flip + one-time migration fee — D9); the
//              team allocation becomes claimable (D3). The curve keeps
//              serving trades at the graduated fee until migrate() moves
//              everything to the DEX pool (D15).
// ============================================================================
entry buy(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)
    require(s.load(PAUSED_KEY).unwrap_or(false) == false, "paused")

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status == ST_BONDING || status == ST_GRADUATED || status == ST_TRUSTED, "notrade")
    require(s.load(proj_key(pid, F_MIGRATED)).unwrap_or(false) == false, "migrated")

    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let dep: u64 = get_deposit_for_asset(xel).unwrap_or(0)
    require(dep >= MIN_BUY_XEL, "tiny")
    require(dep <= MAX_TRADE_XEL, "toobig")

    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    let bps: u64 = current_fee_bps(graduated)
    let fee: u64 = fee_take(dep, bps)
    let net: u64 = dep - fee

    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    require(reserves > 0 && curve_supply > 0, "empty")

    let tokens: u64 = buy_tokens_out(reserves, curve_supply, net)
    require(tokens >= 1, "tinyout")
    require(curve_supply >= tokens, "curverr")

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    // Curve state (net joins reserves, tokens leave the inventory — D14).
    let new_reserves: u64 = reserves + net
    s.store(proj_key(pid, F_RESERVES), new_reserves)
    s.store(proj_key(pid, F_CURVE), curve_supply - tokens)
    s.store(TOTAL_CURVE_XEL_KEY, checked_add(s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0), net))

    // Accounting (D12): directional + total volume, trade count, last
    // trade topo — per project and protocol-wide, all overflow-guarded.
    record_trade(pid, true, dep)
    if fee > 0 {
        let pending: u64 = s.load(PENDING_FEES_KEY).unwrap_or(0)
        s.store(PENDING_FEES_KEY, checked_add(pending, fee))
    }

    // The REAL tokens go to the buyer's wallet (I1: balance follows the
    // inventory — the transfer and the curve update cancel out on the
    // contract's asset balance).
    let asset_opt: optional<Hash> = s.load(proj_key(pid, F_ASSET))
    require(asset_opt.is_some(), "noasset")
    let asset: Hash = asset_opt.expect("guarded")
    let ok: bool = transfer(caller, tokens, asset)
    require(ok, "txfail")

    emit_event(EV_TOKENS_BOUGHT, [pid.to_string(10u32), dep.to_string(10u32), tokens.to_string(10u32), fee.to_string(10u32)])

    // Graduation check (I6): only from Bonding, only once.
    if status == ST_BONDING {
        let liquidity: u64 = s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0)
        let multiplier: u64 = s.load(GRAD_MULTIPLIER_KEY).unwrap_or(DEFAULT_GRAD_MULTIPLIER)
        if (new_reserves as u128) >= (liquidity as u128) * (multiplier as u128) {
            graduate(pid)
        }
    }

    // D12 — stored market cap follows every curve state change (idempotent
    // recompute; also covers the graduation fee when it just happened).
    update_market_cap(pid)
    return tokens
}

// ============================================================================
// 25. SELL — trade REAL tokens back for XEL. NEVER blockable (D4, I8).
// ============================================================================
// Works in Bonding, Graduated (pre-migration), Trusted, Untrusted AND
// during a recovery window: holders can always exit. The WHOLE attached
// token deposit is sold (symmetric with buy — nothing can be stranded);
// the tokens return to the curve's inventory (the deposit credited the
// contract's balance), the gross XEL leaves the reserves, the trading fee
// (graduated rate if the project graduated — D8) goes to pending_fees, and
// the rest is transferred to the caller (checked transfer). After
// migration the curve is closed — holders sell on the DEX pool instead
// (sells there are never pausable either, D4/D17).
// ============================================================================
entry sell(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status == ST_BONDING || status == ST_GRADUATED || status == ST_TRUSTED || status == ST_UNTRUSTED || status == ST_RECOVERY, "nosell")
    require(s.load(proj_key(pid, F_MIGRATED)).unwrap_or(false) == false, "migrated")

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    // The sale amount IS the attached token deposit (D14 — whole-deposit
    // semantics; a partial sale would strand the rest).
    let asset_opt: optional<Hash> = s.load(proj_key(pid, F_ASSET))
    require(asset_opt.is_some(), "noasset")
    let asset: Hash = asset_opt.expect("guarded")
    let dep: u64 = get_deposit_for_asset(asset).unwrap_or(0)
    require(dep >= 1, "nosell")

    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    require(reserves > 0 && curve_supply > 0, "empty")

    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    let bps: u64 = current_fee_bps(graduated)
    let gross: u64 = sell_xel_out(reserves, curve_supply, dep)
    require(gross >= 1, "tiny")
    let fee: u64 = fee_take(gross, bps)
    let out: u64 = gross - fee
    require(out >= 1, "tinyout")
    require(reserves >= gross, "curverr")

    // Curve state (tokens return to the inventory, gross XEL leaves
    // reserves — D14/D20).
    s.store(proj_key(pid, F_RESERVES), reserves - gross)
    s.store(proj_key(pid, F_CURVE), curve_supply + dep)
    let curve_xel: u64 = s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0)
    require(curve_xel >= gross, "accerr")
    s.store(TOTAL_CURVE_XEL_KEY, curve_xel - gross)

    // Accounting (D12): sell-side volume uses the PRE-FEE gross.
    record_trade(pid, false, gross)
    if fee > 0 {
        let pending: u64 = s.load(PENDING_FEES_KEY).unwrap_or(0)
        s.store(PENDING_FEES_KEY, checked_add(pending, fee))
    }

    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let ok: bool = transfer(caller, out, xel)
    require(ok, "txfail")

    emit_event(EV_TOKENS_SOLD, [pid.to_string(10u32), dep.to_string(10u32), out.to_string(10u32), fee.to_string(10u32)])

    // D12 — stored market cap follows every curve state change.
    update_market_cap(pid)
    return out
}

// ============================================================================
// 26. CLAIM REFUND — the founder's exit on a REJECTED project.
// ============================================================================
// Only for a project that FAILED its initial validation, only by the
// creator, exactly once: 100% of the deposited liquidity AND the unused
// asset budget (no asset was ever created — D13) are returned. (Projects
// that reached trading can never be "rejected" — the curve's XEL then
// belongs to the market, not to the founder alone.)
// ============================================================================
entry claim_refund(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status == ST_REJECTED, "norefund")

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    require(creator_opt.is_some(), "nocr")
    let creator: Address = creator_opt.expect("guarded")
    require(caller == creator, "notauth")

    require(s.load(proj_key(pid, F_REFUND)).unwrap_or(false) == false, "claimed")
    let liquidity: u64 = s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0)
    let budget: u64 = s.load(proj_key(pid, F_BUDGET)).unwrap_or(0)
    s.store(proj_key(pid, F_REFUND), true)
    s.store(proj_key(pid, F_BUDGET), 0u64)

    let locked: u64 = s.load(LOCKED_REFUNDS_KEY).unwrap_or(0)
    require(locked >= liquidity, "accerr")
    s.store(LOCKED_REFUNDS_KEY, locked - liquidity)
    if budget > 0 {
        let tbb: u64 = s.load(TOTAL_BUDGETS_KEY).unwrap_or(0)
        require(tbb >= budget, "accerr")
        s.store(TOTAL_BUDGETS_KEY, tbb - budget)
    }

    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let total: u64 = checked_add(liquidity, budget)
    let ok: bool = transfer(caller, total, xel)
    require(ok, "txfail")

    emit_event(EV_REFUND_CLAIMED, [pid.to_string(10u32), total.to_string(10u32)])
    return 0
}

// ============================================================================
// 26b. CLAIM VOTE DEPOSIT — the voter's refund (D21, the sybil dial).
// ============================================================================
// Pull-pattern refund: a voter who locked a deposit (support/report with
// the D21 dial raised) claims it back HERE once the round they voted in
// has closed — either the project moved to a newer round (request_
// revalidation) or the window's deadline has passed. Per-voter pull, so
// no finalize ever loops over voters (Silex forbids unbounded loops;
// voters who never claim simply leave their deposit claimable forever —
// nothing is lost, nothing is confiscated). The vote slot is zeroed but
// kept: the vote stays counted (I5), the deposit leaves exactly once.
// Callable by the voter only, for any round they actually voted in.
// ============================================================================
entry claim_vote_deposit(pid: u64, round: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    // The round must be CLOSED: either a newer round exists, or this
    // round's window has ended (F_DEADLINE always holds the CURRENT
    // round's end — an older round is closed by definition).
    let cur_round: u64 = s.load(proj_key(pid, F_ROUND)).unwrap_or(0)
    require(round <= cur_round, "badround")
    if round == cur_round {
        let deadline: u64 = s.load(proj_key(pid, F_DEADLINE)).unwrap_or(0)
        require(get_current_topoheight() >= deadline, "open")
    }

    let vkey: string = vote_key(pid, round, caller)
    let locked_opt: optional<u64> = s.load(vkey)
    require(locked_opt.is_some(), "novote")
    let locked: u64 = locked_opt.expect("guarded")
    require(locked > 0, "nothing")

    // State first (I5: zeroed but kept), transfer last.
    s.store(vkey, 0u64)
    let pots: u64 = s.load(VOTE_POTS_KEY).unwrap_or(0)
    require(pots >= locked, "accerr")
    s.store(VOTE_POTS_KEY, pots - locked)

    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let ok: bool = transfer(caller, locked, xel)
    require(ok, "txfail")

    emit_event(EV_VOTE_DEPOSIT_CLAIMED, [pid.to_string(10u32), round.to_string(10u32), locked.to_string(10u32)])
    return locked
}

// ============================================================================
// 28. REQUEST REVALIDATION — the creator's path back from Untrusted.
// ============================================================================
// Opens a fresh voting window (tallies and the voted-map reset via a new
// round number). For a project that already graduated, the recovery_fee is
// charged (attached deposit must equal it EXACTLY — it goes to the admin
// via pending_fees) and the STRICTER thresholds apply at finalization.
// Non-graduated projects retry for free under normal thresholds.
// ============================================================================
entry request_revalidation(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status == ST_UNTRUSTED, "badstate")

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    require(creator_opt.is_some(), "nocr")
    let creator: Address = creator_opt.expect("guarded")
    require(caller == creator, "notauth")

    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    if graduated {
        let recovery_fee: u64 = s.load(RECOVERY_FEE_KEY).unwrap_or(DEFAULT_RECOVERY_FEE)
        let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
        let dep: u64 = get_deposit_for_asset(xel).unwrap_or(0)
        require(dep == recovery_fee, "badfee")
        if recovery_fee > 0 {
            let pending: u64 = s.load(PENDING_FEES_KEY).unwrap_or(0)
            s.store(PENDING_FEES_KEY, checked_add(pending, recovery_fee))
        }
    }

    let round: u64 = s.load(proj_key(pid, F_ROUND)).unwrap_or(0)
    s.store(proj_key(pid, F_ROUND), round + 1)
    s.store(proj_key(pid, F_SUPPORTS), 0u64)
    s.store(proj_key(pid, F_REPORTS), 0u64)
    let duration: u64 = s.load(VALIDATION_DURATION_KEY).unwrap_or(DEFAULT_VALIDATION_TOPO)
    s.store(proj_key(pid, F_DEADLINE), get_current_topoheight() + duration)
    s.store(proj_key(pid, F_STATUS), ST_RECOVERY)

    emit_event(EV_RECOVERY_REQUESTED, [pid.to_string(10u32), (round + 1).to_string(10u32)])
    return 0
}

// ============================================================================
// 29. UPDATE PROJECT INFO — metadata maintenance (creator only).
// ============================================================================
// Description, website, logo AND the social links (D11) can be updated at
// any time (except on a Rejected project) — communities move, channels get
// rebuilt; name, symbol, supply, team allocation and the vesting plan are
// structural and immutable by design (the plan is the votable commitment,
// D10 — changing it after the vote would be changing the ballot; the symbol
// is moreover reserved in the ticker registry).
// ============================================================================
entry update_project_info(pid: u64, description: string, website: string, logo: string, twitter: string, telegram: string, discord: string) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    require(status != ST_REJECTED, "dead")

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    require(creator_opt.is_some(), "nocr")
    let creator: Address = creator_opt.expect("guarded")
    require(caller == creator, "notauth")

    require(description.len() <= MAX_DESC_LEN, "baddesc")
    require(website.len() <= MAX_URL_LEN, "badurl")
    require(logo.len() <= MAX_URL_LEN, "badlogo")
    require(twitter.len() <= MAX_URL_LEN, "badtw")
    require(telegram.len() <= MAX_URL_LEN, "badtg")
    require(discord.len() <= MAX_URL_LEN, "baddc")

    s.store(proj_key(pid, F_DESC), description)
    s.store(proj_key(pid, F_WEBSITE), website)
    s.store(proj_key(pid, F_LOGO), logo)
    s.store(proj_key(pid, F_TWITTER), twitter)
    s.store(proj_key(pid, F_TELEGRAM), telegram)
    s.store(proj_key(pid, F_DISCORD), discord)

    emit_event(EV_PROJECT_INFO_UPDATED, [pid.to_string(10u32)])
    return 0
}

// ============================================================================
// 30. START TEAM VESTING — the creator's voluntary long-term commitment.
// ============================================================================
// @caller: the project creator (a wallet).
// @params: duration — linear vesting length in topoheights, within the
//          admin-bounded window [vesting_min, vesting_max].
// @rules:  eligible once the allocation is unlockable at all: after
//          graduation (immediately), or for a never-graduated project after
//          team_unlock_delay of bonding (D3). Once started, the vesting is
//          IRREVERSIBLE — that is the point: it is a public commitment the
//          frontend can show (get_team_allocation). NOT available to
//          projects that declared a vesting plan at propose time (D10): the
//          plan binds itself at graduation — exactly the schedule the
//          community voted on, no re-tuning possible.
// ============================================================================
entry start_team_vesting(pid: u64, duration: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    require(creator_opt.is_some(), "nocr")
    let creator: Address = creator_opt.expect("guarded")
    require(caller == creator, "notauth")

    // D10: a declared plan IS the vesting — it starts by itself at
    // graduation and can be neither replaced nor duplicated.
    require(s.load(proj_key(pid, F_VESTING_PLAN)).unwrap_or(0) == 0, "planned")

    // Exactly one vesting per project, and only while something is owed.
    require(s.load(proj_key(pid, F_VESTING_START)).unwrap_or(0) == 0, "started")
    require(team_remaining(pid) > 0, "done")

    let min_dur: u64 = s.load(VESTING_MIN_KEY).unwrap_or(DEFAULT_VESTING_MIN)
    let max_dur: u64 = s.load(VESTING_MAX_KEY).unwrap_or(DEFAULT_VESTING_MAX)
    require(duration >= min_dur && duration <= max_dur, "baddur")

    // Eligibility mirrors claim_team_allocation (D3): the allocation must
    // be unlockable NOW (graduated, or bonding past the unlock delay).
    require(team_unlocked(pid) > 0, "notyet")

    s.store(proj_key(pid, F_VESTING_START), get_current_topoheight())
    s.store(proj_key(pid, F_VESTING_DURATION), duration)

    emit_event(EV_TEAM_VESTING_STARTED, [pid.to_string(10u32), duration.to_string(10u32)])
    return 0
}

// ============================================================================
// 31. CLAIM TEAM ALLOCATION — the creator's payout, all paths, once (I4).
// ============================================================================
// @caller: the project creator (a wallet).
// @rules:  pays team_unlocked(pid) - team_paid, as REAL tokens transferred
//            from the launchpad's escrow (the contract retains exactly
//            team_remaining after migration — I10):
//            * vesting active  -> the linear share accrued so far (D3);
//            * graduated       -> the full remaining allocation (the
//                                 migration reward), unless a vesting is
//                                 running (then only the accrued share);
//            * never graduated -> the full allocation, but only after
//                                 team_unlock_delay of bonding (the late
//                                 claim — founders are never hostage);
//            * otherwise (Validation / Rejected / too early) -> revert.
//          team_paid debits every payout, so the allocation is paid exactly
//          once across ALL paths (I4). The event carries NO amount: the
//          payout is a native confidential transfer, and only the creator
//          sees it (D18).
// ============================================================================
entry claim_team_allocation(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    require(creator_opt.is_some(), "nocr")
    let creator: Address = creator_opt.expect("guarded")
    require(caller == creator, "notauth")

    let unlocked: u64 = team_unlocked(pid)
    let paid: u64 = s.load(proj_key(pid, F_TEAM_PAID)).unwrap_or(0)
    require(unlocked > paid, "nothing")

    let pay: u64 = unlocked - paid
    s.store(proj_key(pid, F_TEAM_PAID), paid + pay)

    // The REAL escrow payout (I1/I10: the transfer and the team_remaining
    // drop cancel out on the contract's asset balance).
    let asset_opt: optional<Hash> = s.load(proj_key(pid, F_ASSET))
    require(asset_opt.is_some(), "noasset")
    let asset: Hash = asset_opt.expect("guarded")
    let ok: bool = transfer(creator, pay, asset)
    require(ok, "txfail")

    // D12 — a claim shrinks team_remaining, i.e. GROWS circulating supply:
    // the stored market cap follows immediately (curve era only).
    update_market_cap(pid)

    // D18 — NO amount in the event: the payout is the creator's private
    // business (a native confidential transfer).
    emit_event(EV_TEAM_CLAIMED, [pid.to_string(10u32)])
    return pay
}

// ============================================================================
// 32. MIGRATE — the permissionless, atomic move to LaunchDEX (D15).
// ============================================================================
// @caller: ANYONE (a wallet). The outcome is fully determined by the
//          project's state: the curve's whole XEL reserves and its whole
//          token inventory (team escrow excepted) seed a permanent pool on
//          the PINNED DEX contract (D19). No destination, no amount, no
//          caller choice anywhere — a "malicious" migrator can only
//          execute the migration the community is waiting for.
// @permission: this transaction must carry the contract-call permission
//          (it cross-calls the DEX). The precheck refuses with "txperm"
//          instead of an opaque failure.
// @rules:  requires the project graduated (curve path or direct listing)
//          and has not migrated yet. After success the curve is closed
//          forever; the launchpad remains the project's home for votes,
//          socials, trust and team claims (D3/D11/D17). If the project is
//          Untrusted at migration time, the pool's buys are paused in the
//          same transaction (D17 — no unprotected window).
// ============================================================================
entry migrate(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    require(s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false) == true, "notgrad")
    require(s.load(proj_key(pid, F_MIGRATED)).unwrap_or(false) == false, "done")

    migrate_to_dex(pid)

    let xel: u64 = s.load(proj_key(pid, F_MIG_XEL)).unwrap_or(0)
    let tok: u64 = s.load(proj_key(pid, F_MIG_TOK)).unwrap_or(0)
    emit_event(EV_MIGRATED, [pid.to_string(10u32), xel.to_string(10u32), tok.to_string(10u32)])
    return 0
}

// ============================================================================
// 33. SYNC TRUST TO DEX — the community keeper for the pool's buys-pause
//     (D17).
// ============================================================================
// @caller: ANYONE (a wallet) — keeper bots, a frontend button, anyone.
//          Mirrors the launchpad's trust status to the migrated pool:
//          Untrusted -> pool buys paused; recovered (Trusted/Graduated
//          from a recovery pass) -> pool buys unpaused. Sells are never
//          touched (D4). No-op when already in sync ("insync").
// @permission: cross-calls the DEX — the transaction must carry the
//          contract-call permission ("txperm" refusal otherwise).
// @why permissionless and separate: embedding the cross-call inside
//          report/support would force EVERY voter's wallet to grant the
//          contract-call permission — a trap this design refuses (D17).
// ============================================================================
entry sync_trust_to_dex(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)

    require(s.load(proj_key(pid, F_MIGRATED)).unwrap_or(false) == true, "notmig")

    let status: u64 = s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
    let flag: bool = status == ST_UNTRUSTED
    require(s.load(proj_key(pid, F_DEX_SYNCED)).unwrap_or(false) != flag, "insync")

    let dex_opt: optional<Hash> = s.load(DEX_ADDRESS_KEY)
    require(dex_opt.is_some(), "nodex")
    let dex: Hash = dex_opt.expect("guarded")

    let asset_opt: optional<Hash> = s.load(proj_key(pid, F_ASSET))
    require(asset_opt.is_some(), "noasset")
    let asset: Hash = asset_opt.expect("guarded")

    // State first (atomic with the call), transfer of authority last.
    s.store(proj_key(pid, F_DEX_SYNCED), flag)

    require(is_contract_callable(dex, DEX_SET_PAUSED_CHUNK), "txperm")
    let target_opt: optional<Contract> = Contract::new(dex)
    require(target_opt.is_some(), "dexgone")
    let target: Contract = target_opt.expect("guarded")
    target.call(DEX_SET_PAUSED_CHUNK, [asset, flag], {})

    if flag {
        emit_event(EV_DEX_SYNCED, [pid.to_string(10u32), "1"])
    } else {
        emit_event(EV_DEX_SYNCED, [pid.to_string(10u32), "0"])
    }
    return 0
}
// ============================================================================
// ADMIN — parameter setters (all range-checked, pairs cross-checked) + fee
// withdrawal.
// ============================================================================

// 34. Submission fee (one-time, per proposal). Cap: 100 XEL.
entry set_submission_fee(fee: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(fee <= MAX_SUBMISSION_FEE, "toohigh")
    s.store(SUBMISSION_FEE_KEY, fee)
    emit_event(EV_PARAM_SET, ["submission_fee", fee.to_string(10u32)])
    return 0
}

// 35. Trading fee in basis points, on buys AND sells while bonding.
//     Hard cap: 10%. Cross-checked (D8): can never drop below the
//     graduated fee — graduation must always be the cheaper regime.
entry set_trading_fee(bps: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(bps <= MAX_TRADING_FEE_BPS, "toohigh")
    let graduated_fee: u64 = s.load(GRADUATED_FEE_KEY).unwrap_or(DEFAULT_GRADUATED_FEE_BPS)
    require(bps >= graduated_fee, "croserr")
    s.store(TRADING_FEE_KEY, bps)
    emit_event(EV_PARAM_SET, ["trading_fee_bps", bps.to_string(10u32)])
    return 0
}

// 36. Graduated trading fee (D8): what a graduated project pays on every
//     curve trade between graduation and migration. Hard cap: 10%.
//     Cross-checked: <= trading_fee_bps, so the graduation discount can
//     never invert.
entry set_graduated_trading_fee(bps: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(bps <= MAX_GRADUATED_FEE_BPS, "toohigh")
    let trading_fee: u64 = s.load(TRADING_FEE_KEY).unwrap_or(DEFAULT_TRADING_FEE_BPS)
    require(bps <= trading_fee, "croserr")
    s.store(GRADUATED_FEE_KEY, bps)
    emit_event(EV_PARAM_SET, ["graduated_fee_bps", bps.to_string(10u32)])
    return 0
}

// 37. Migration fee (D9): taken once from a project's reserves when it
//     graduates (curve path or direct listing). Hard cap: 5%.
entry set_migration_fee(bps: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(bps <= MAX_MIGRATION_FEE_BPS, "toohigh")
    s.store(MIGRATION_FEE_KEY, bps)
    emit_event(EV_PARAM_SET, ["migration_fee_bps", bps.to_string(10u32)])
    return 0
}

// 38. Direct-listing threshold (D7): the liquidity that skips the bonding
//     phase. Cross-checked: >= min_liquidity, so the fast track can never
//     swallow every proposal (a small float always gets its curve).
//     Snapshotted per project at propose time.
entry set_direct_listing_threshold(amount: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(amount <= MAX_DIRECT_LISTING, "toohigh")
    let min_liq: u64 = s.load(MIN_LIQUIDITY_KEY).unwrap_or(DEFAULT_MIN_LIQUIDITY)
    require(amount >= min_liq, "croserr")
    s.store(DIRECT_LISTING_KEY, amount)
    emit_event(EV_PARAM_SET, ["direct_listing_threshold", amount.to_string(10u32)])
    return 0
}

// 39. Minimum founder liquidity, in [1 XEL, 100k XEL]. Cross-checked
//     (D7): can never exceed the direct-listing threshold.
entry set_min_liquidity(amount: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(amount >= MIN_LIQUIDITY_FLOOR, "toolow")
    require(amount <= MAX_MIN_LIQUIDITY, "toohigh")
    let threshold: u64 = s.load(DIRECT_LISTING_KEY).unwrap_or(DEFAULT_DIRECT_LISTING)
    require(amount <= threshold, "croserr")
    s.store(MIN_LIQUIDITY_KEY, amount)
    emit_event(EV_PARAM_SET, ["min_liquidity", amount.to_string(10u32)])
    return 0
}

// 40. Minimum voters to validate/reject a project, in [1, 100k].
entry set_min_participants(count: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(count >= 1, "toolow")
    require(count <= MAX_PARTICIPANTS, "toohigh")
    s.store(MIN_PARTICIPANTS_KEY, count)
    emit_event(EV_PARAM_SET, ["min_participants", count.to_string(10u32)])
    return 0
}

// 41. Minimum support ratio, in (50%, 100%] basis points.
entry set_min_approval_ratio(bps: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(bps >= MIN_RATIO_BPS, "toolow")
    require(bps <= 10000, "toohigh")
    s.store(MIN_APPROVAL_KEY, bps)
    emit_event(EV_PARAM_SET, ["min_approval_ratio_bps", bps.to_string(10u32)])
    return 0
}

// 42. Validation window length in topoheights, [~1h, ~15d].
entry set_validation_duration(topos: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(topos >= MIN_VALIDATION_TOPO, "toolow")
    require(topos <= MAX_VALIDATION_TOPO, "toohigh")
    s.store(VALIDATION_DURATION_KEY, topos)
    emit_event(EV_PARAM_SET, ["validation_duration", topos.to_string(10u32)])
    return 0
}

// 43. Graduation multiplier: graduate at liquidity x multiplier, [2, 100].
entry set_graduation_multiplier(multiplier: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(multiplier >= MIN_GRAD_MULTIPLIER, "toolow")
    require(multiplier <= MAX_GRAD_MULTIPLIER, "toohigh")
    s.store(GRAD_MULTIPLIER_KEY, multiplier)
    emit_event(EV_PARAM_SET, ["graduation_multiplier", multiplier.to_string(10u32)])
    return 0
}

// 44. Team unlock delay (D3): how long a NEVER-graduated project must
//     trade before its creator may claim the team allocation late.
//     [~5 days, ~2 years].
entry set_team_unlock_delay(topos: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(topos >= MIN_TEAM_DELAY_TOPO, "toolow")
    require(topos <= MAX_TEAM_DELAY_TOPO, "toohigh")
    s.store(TEAM_DELAY_KEY, topos)
    emit_event(EV_PARAM_SET, ["team_unlock_delay", topos.to_string(10u32)])
    return 0
}

// 45. Vesting bounds (D3): the window inside which a creator may choose a
//     linear vesting duration. Absolute caps: [~1 day, ~2 years]; the
//     window itself must stay non-empty (min < max).
entry set_vesting_bounds(min_topos: u64, max_topos: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(min_topos >= VESTING_FLOOR_TOPO, "toolow")
    require(max_topos <= VESTING_CEIL_TOPO, "toohigh")
    require(min_topos < max_topos, "croserr")
    s.store(VESTING_MIN_KEY, min_topos)
    s.store(VESTING_MAX_KEY, max_topos)
    emit_event(EV_PARAM_SET, ["vesting_bounds", min_topos.to_string(10u32) + ":" + max_topos.to_string(10u32)])
    return 0
}

// 46. Recovery fee for GRADUATED projects requesting revalidation.
//     Cap: 1000 XEL. (Non-graduated projects always retry for free.)
entry set_recovery_fee(fee: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(fee <= MAX_RECOVERY_FEE, "toohigh")
    s.store(RECOVERY_FEE_KEY, fee)
    emit_event(EV_PARAM_SET, ["recovery_fee", fee.to_string(10u32)])
    return 0
}

// 47. Stricter recovery thresholds: quorum in [1, 100k], ratio in (50%, 100%].
entry set_recovery_params(participants: u64, ratio_bps: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(participants >= 1, "toolow")
    require(participants <= MAX_PARTICIPANTS, "toohigh")
    require(ratio_bps >= MIN_RATIO_BPS, "toolow")
    require(ratio_bps <= 10000, "toohigh")
    s.store(RECOVERY_PARTICIPANTS_KEY, participants)
    s.store(RECOVERY_RATIO_KEY, ratio_bps)
    emit_event(EV_PARAM_SET, ["recovery_params", participants.to_string(10u32) + ":" + ratio_bps.to_string(10u32)])
    return 0
}

// 48. ASSET BUDGET (D13): what every proposal earmarks for the chain's
//     asset creation cost. The actual fee is measured at creation and the
//     unused part is refunded; a raise only affects FUTURE proposals
//     (existing ones top up at finalize if needed). Cap: 100 XEL.
entry set_asset_budget(amount: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(amount <= MAX_ASSET_BUDGET, "toohigh")
    s.store(ASSET_BUDGET_KEY, amount)
    emit_event(EV_PARAM_SET, ["asset_budget", amount.to_string(10u32)])
    return 0
}

// 47b. VOTE DEPOSIT (D21): the sybil dial. When > 0, every support()/
//      report() must attach exactly this XEL amount (locked for the
//      round, refunded by claim_vote_deposit). Default 0.5 XEL since
//      v4.2 (founder risk review, point 2): 20 farmed wallets deciding
//      a validation must at least park 10 XEL of refundable capital
//      while they do it. The admin can still zero it (0 = free voting)
//      or raise it under attack. A raise only affects FUTURE votes
//      (already-locked deposits are refunded at their own recorded
//      amount). Cap: 10 XEL — a sybil cost, never a participation toll.
entry set_vote_deposit(amount: u64) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(amount <= MAX_VOTE_DEPOSIT, "toohigh")
    s.store(VOTE_DEPOSIT_KEY, amount)
    emit_event(EV_PARAM_SET, ["vote_deposit", amount.to_string(10u32)])
    return 0
}

// 50. DEX ADDRESS PIN (D19): the LaunchDEX contract migrations seed.
//     Settable ONLY while no project has ever migrated (migrated_count
//     must be 0) — after the first migration the pin is FROZEN FOREVER
//     (the pools live inside that contract; repointing would orphan them).
//     LaunchDEX mirrors the freeze: its launchpad pin freezes at ITS first
//     pool. Both sides verified by CI against each other's chunk numbering.
entry set_dex_address(addr: Hash) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    require(s.load(MIGRATED_COUNT_KEY).unwrap_or(0) == 0, "frozen")
    s.store(DEX_ADDRESS_KEY, addr)
    emit_event(EV_DEX_ADDRESS, [addr.to_hex()])
    return 0
}

// 51. Transfer the admin role (single-step — use a cold wallet).
entry set_admin(new_admin: Address) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    s.store(ADMIN_KEY, new_admin)
    emit_event(EV_ADMIN_SET, [new_admin.to_string()])
    return 0
}

// 52. Circuit breaker: pauses NEW proposals and NEW buys only (D-security).
//     Sells, votes, refunds, team claims, migration and finalization are
//     never pausable: exits, community decisions and the move to the DEX
//     cannot be frozen.
entry set_paused(flag: bool) -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    s.store(PAUSED_KEY, flag)
    if flag {
        emit_event(EV_PAUSED, ["admin"])
    } else {
        emit_event(EV_UNPAUSED, ["admin"])
    }
    return 0
}

// 53. WITHDRAW FEES — the protocol's entire revenue stream.
// ============================================================================
// Admin-only. Capped twice: by the accrued pending_fees AND by the
// contract's uncommitted balance (balance - live curve reserves - locked
// refunds - earmarked asset budgets - locked vote pots — D20/D21) — the
// admin can never make the protocol insolvent (I2).
// ============================================================================
entry withdraw_fees(amount: u64) -> u64 {
    let s: Storage = Storage::new()

    let caller_opt: optional<Address> = get_caller()
    require(caller_opt.is_some(), "walletonly")
    let caller: Address = caller_opt.expect("guarded")

    let admin_opt: optional<Address> = s.load(ADMIN_KEY)
    require(admin_opt.is_some(), "noadmin")
    let admin: Address = admin_opt.expect("guarded")
    require(caller == admin, "notauth")

    require(amount > 0, "badamt")
    let pending: u64 = s.load(PENDING_FEES_KEY).unwrap_or(0)
    require(amount <= pending, "badamt")

    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    let balance: u64 = get_balance_for_asset(xel).unwrap_or(0)
    let curve_xel: u64 = s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0)
    let locked: u64 = s.load(LOCKED_REFUNDS_KEY).unwrap_or(0)
    let budgets: u64 = s.load(TOTAL_BUDGETS_KEY).unwrap_or(0)
    let pots: u64 = s.load(VOTE_POTS_KEY).unwrap_or(0)
    let committed: u128 = (curve_xel as u128) + (locked as u128) + (budgets as u128) + (pots as u128)
    require((amount as u128) + committed <= (balance as u128), "notavail")

    s.store(PENDING_FEES_KEY, pending - amount)
    let lifetime: u64 = s.load(FEES_LIFETIME_KEY).unwrap_or(0)
    s.store(FEES_LIFETIME_KEY, checked_add(lifetime, amount))

    let ok: bool = transfer(caller, amount, xel)
    require(ok, "txfail")

    emit_event(EV_FEES_COLLECTED, [amount.to_string(10u32)])
    return 0
}
// ============================================================================
// VIEWS (pub fn — read-only, no storage writes; the frontend's API)
// ============================================================================

// 54. Lifecycle snapshot: (creator, status, created_topo, validation_end,
//     graduated). creator is a display string; status is the code (see
//     get_status_label). For the migration state use get_migration_info.
pub fn get_project(pid: u64) -> (string, u64, u64, u64, bool) {
    let s: Storage = Storage::new()
    require_project(pid)

    let creator: string = "unknown"
    let creator_opt: optional<Address> = s.load(proj_key(pid, F_CREATOR))
    if creator_opt.is_some() {
        let c: Address = creator_opt.expect("guarded")
        creator = c.to_string()
    }

    return (
        creator,
        s.load(proj_key(pid, F_STATUS)).unwrap_or(0),
        s.load(proj_key(pid, F_CREATED)).unwrap_or(0),
        s.load(proj_key(pid, F_DEADLINE)).unwrap_or(0),
        s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    )
}

// 55. Display metadata: (name, symbol, description, website, logo).
pub fn get_project_info(pid: u64) -> (string, string, string, string, string) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_NAME)).unwrap_or(""),
        s.load(proj_key(pid, F_SYMBOL)).unwrap_or(""),
        s.load(proj_key(pid, F_DESC)).unwrap_or(""),
        s.load(proj_key(pid, F_WEBSITE)).unwrap_or(""),
        s.load(proj_key(pid, F_LOGO)).unwrap_or("")
    )
}

// 56. Status code of a project (see get_status_label for the text).
pub fn get_project_status(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)
    return s.load(proj_key(pid, F_STATUS)).unwrap_or(0)
}

// 57. Tokenomics: (total_supply, team_bps, liquidity_deposited, reserves,
//     curve_supply). All atomic units. total_supply is the asset's FIXED
//     max supply (D13); reserves/curve_supply are the live curve state
//     (both 0 once migrated — the pool owns the market then).
pub fn get_project_tokenomics(pid: u64) -> (u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0),
        s.load(proj_key(pid, F_TEAM_BPS)).unwrap_or(0),
        s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0),
        s.load(proj_key(pid, F_RESERVES)).unwrap_or(0),
        s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    )
}

// 58. Trust state: (supports, reports, vote_round, graduated).
pub fn get_project_trust(pid: u64) -> (u64, u64, u64, bool) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_SUPPORTS)).unwrap_or(0),
        s.load(proj_key(pid, F_REPORTS)).unwrap_or(0),
        s.load(proj_key(pid, F_ROUND)).unwrap_or(0),
        s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    )
}

// 59. Curve state: (reserves, curve_supply, volume, graduation_target,
//     bonding_start). graduation_target = liquidity_deposited *
//     graduation_multiplier (the curve path's goal; a direct-listed project
//     starts beyond it). bonding_start = when trading opened (0 while in
//     validation) — the anchor of the team unlock delay. Post-migration the
//     reserves/curve_supply read 0 (the curve is closed — D15).
pub fn get_bonding_info(pid: u64) -> (u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    require_project(pid)
    let liquidity: u64 = s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0)
    let multiplier: u64 = s.load(GRAD_MULTIPLIER_KEY).unwrap_or(DEFAULT_GRAD_MULTIPLIER)
    let target: u128 = (liquidity as u128) * (multiplier as u128)
    let grad_target: u64 = U64_MAX
    if target <= U64_MAX_128 {
        grad_target = target as u64
    }
    return (
        s.load(proj_key(pid, F_RESERVES)).unwrap_or(0),
        s.load(proj_key(pid, F_CURVE)).unwrap_or(0),
        s.load(proj_key(pid, F_VOLUME)).unwrap_or(0),
        grad_target,
        s.load(proj_key(pid, F_BONDING_START)).unwrap_or(0)
    )
}

// 60. Spot price: XEL (scaled by 1e8) per 1 whole token — i.e.
//     reserves * 1e8 / curve_supply. CURVE-ERA price: returns 0 once
//     migrated (the live price is LaunchDEX's get_spot_price — the SDK
//     composes both). Saturates at u64 max.
pub fn get_current_price(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    if curve_supply == 0 {
        return 0
    }
    let scaled: u128 = (reserves as u128) * (PRICE_SCALE as u128) / (curve_supply as u128)
    if scaled > U64_MAX_128 {
        return U64_MAX
    }
    return scaled as u64
}

// 61. Buy quote: tokens out for an attached XEL amount (fee included).
//     Uses the project's EFFECTIVE fee (graduated rate once graduated —
//     D8), exactly like buy() — a quote can never disagree with the trade.
pub fn get_buy_quote(pid: u64, xel_amount: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    let bps: u64 = current_fee_bps(graduated)
    let net: u64 = xel_amount - fee_take(xel_amount, bps)
    return buy_tokens_out(reserves, curve_supply, net)
}

// 62. Sell quote: XEL out (net of fee) for a token amount — same effective
//     fee rule as sell(). (sell() itself takes no amount: it sells the
//     whole attached deposit; this quote is the preview for any amount.)
pub fn get_sell_quote(pid: u64, token_amount: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    let graduated: bool = s.load(proj_key(pid, F_GRADUATED)).unwrap_or(false)
    let bps: u64 = current_fee_bps(graduated)
    let gross: u64 = sell_xel_out(reserves, curve_supply, token_amount)
    return gross - fee_take(gross, bps)
}

// 63. Market cap in atomic XEL: reserves * circulating / curve_supply,
//     where circulating = total_supply - curve_supply - team_remaining
//     (the allocation not yet paid to the creator). CURVE-ERA cap (D12):
//     0 once migrated — the live cap is the DEX pool's price x circulating
//     (SDK-composed). Saturates at u64 max (u128 math throughout).
pub fn get_market_cap(pid: u64) -> u64 {
    let s: Storage = Storage::new()
    require_project(pid)
    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)
    let reserves: u64 = s.load(proj_key(pid, F_RESERVES)).unwrap_or(0)
    let curve_supply: u64 = s.load(proj_key(pid, F_CURVE)).unwrap_or(0)
    if curve_supply == 0 {
        return 0
    }
    let team_rem: u128 = team_remaining(pid) as u128
    let circulating: u128 = (total_supply as u128) - (curve_supply as u128) - team_rem
    if circulating == 0 {
        return 0
    }
    let cap: u128 = (reserves as u128) * circulating / (curve_supply as u128)
    if cap > U64_MAX_128 {
        return U64_MAX
    }
    return cap as u64
}

// 64. Has this address already voted in the project's CURRENT round?
pub fn has_voted(pid: u64, voter: Address) -> bool {
    let s: Storage = Storage::new()
    require_project(pid)
    let round: u64 = s.load(proj_key(pid, F_ROUND)).unwrap_or(0)
    // I5 (D21): the slot holds the locked deposit amount — presence IS
    // the vote marker (a claimed deposit is zeroed but kept).
    return s.load(vote_key(pid, round, voter)).is_some()
}

// 65. Total number of projects ever proposed.
pub fn get_total_projects() -> u64 {
    return Storage::new().load(COUNT_KEY).unwrap_or(0)
}

// 66. COUNT of projects with a given status code (listing helper — pair
//     with get_project_by_rank; ids themselves are never returned as an
//     array, Silex ABI ground truth has no array returns).
pub fn get_projects_by_status(status: u64) -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(COUNT_KEY).unwrap_or(0)
    let found: u64 = 0
    for i: u64 = 0; i < MAX_PROJECTS; i += 1 {
        if i < count {
            if s.load(proj_key(i, F_STATUS)).unwrap_or(0) == status {
                found += 1
            }
        }
    }
    return found
}

// 67. Id of the rank-th (0-based, oldest first) project with a given
//     status. Returns project_count (an invalid id) when rank is out of
//     range — the documented sentinel for "no such project".
pub fn get_project_by_rank(status: u64, rank: u64) -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(COUNT_KEY).unwrap_or(0)
    let seen: u64 = 0
    for i: u64 = 0; i < MAX_PROJECTS; i += 1 {
        if i < count {
            if s.load(proj_key(i, F_STATUS)).unwrap_or(0) == status {
                if seen == rank {
                    return i
                }
                seen += 1
            }
        }
    }
    return count
}

// 68. Id of the rank-th LATEST project (any status; rank 0 = newest).
//     Sentinel: project_count when out of range.
pub fn get_latest_projects(rank: u64) -> u64 {
    let count: u64 = Storage::new().load(COUNT_KEY).unwrap_or(0)
    if rank < count {
        return count - 1 - rank
    }
    return count
}

// 69. COUNT of trusted projects (Graduated or Trusted — both mean the
//     community currently backs the project).
pub fn get_trusted_projects() -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(COUNT_KEY).unwrap_or(0)
    let found: u64 = 0
    for i: u64 = 0; i < MAX_PROJECTS; i += 1 {
        if i < count {
            let status: u64 = s.load(proj_key(i, F_STATUS)).unwrap_or(0)
            if status == ST_GRADUATED || status == ST_TRUSTED {
                found += 1
            }
        }
    }
    return found
}

// 70. Id of the rank-th trusted (Graduated/Trusted) project, oldest first.
//     Sentinel: project_count when out of range.
pub fn get_trusted_by_rank(rank: u64) -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(COUNT_KEY).unwrap_or(0)
    let seen: u64 = 0
    for i: u64 = 0; i < MAX_PROJECTS; i += 1 {
        if i < count {
            let status: u64 = s.load(proj_key(i, F_STATUS)).unwrap_or(0)
            if status == ST_GRADUATED || status == ST_TRUSTED {
                if seen == rank {
                    return i
                }
                seen += 1
            }
        }
    }
    return count
}

// 71. TEAM ALLOCATION STATE (D3, D10) — the frontend's commitment panel:
//     (team_alloc, team_paid, vesting_start, vesting_duration,
//      claimable_now, vesting_plan). vesting_start == 0 means no vesting is
//     running; vesting_plan == 0 means "claim at graduation" was declared,
//     any other value is the plan graduate() binds automatically (D10) —
//     show it on the proposal card BEFORE the vote. claimable_now is
//     exactly what claim_team_allocation would pay at the current
//     topoheight (0 = nothing yet — show a countdown). The CLAIMED amounts
//     are the creator's private data (D18): paid is bookkeeping, payouts
//     were confidential transfers.
pub fn get_team_allocation(pid: u64) -> (u64, u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    require_project(pid)
    let total_supply: u64 = s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0)
    let team_bps: u64 = s.load(proj_key(pid, F_TEAM_BPS)).unwrap_or(0)
    let team: u64 = team_alloc_of(total_supply, team_bps)
    let paid: u64 = s.load(proj_key(pid, F_TEAM_PAID)).unwrap_or(0)
    let unlocked: u64 = team_unlocked(pid)
    let claimable: u64 = 0
    if unlocked > paid {
        claimable = unlocked - paid
    }
    return (
        team,
        paid,
        s.load(proj_key(pid, F_VESTING_START)).unwrap_or(0),
        s.load(proj_key(pid, F_VESTING_DURATION)).unwrap_or(0),
        claimable,
        s.load(proj_key(pid, F_VESTING_PLAN)).unwrap_or(0)
    )
}

// 72. Protocol stats: (total_projects, pending_fees, fees_collected_lifetime,
//     total_volume, total_curve_xel, locked_refunds, balance, paused,
//     trading_fee_bps, migrated_count, asset_budgets_earmarked,
//     locked_vote_pots). balance is the live contract XEL balance — the
//     solvency invariant says it covers curve_xel + pending + locked +
//     budgets + vote pots (I2/D20/D21). migrated_count is the number of
//     projects whose liquidity moved to LaunchDEX; once > 0 the DEX pin is
//     frozen (D19).
pub fn get_protocol_stats() -> (u64, u64, u64, u64, u64, u64, u64, bool, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    let xel: Hash = s.load(XEL_ASSET_KEY).unwrap_or(get_xelis_asset())
    return (
        s.load(COUNT_KEY).unwrap_or(0),
        s.load(PENDING_FEES_KEY).unwrap_or(0),
        s.load(FEES_LIFETIME_KEY).unwrap_or(0),
        s.load(TOTAL_VOLUME_KEY).unwrap_or(0),
        s.load(TOTAL_CURVE_XEL_KEY).unwrap_or(0),
        s.load(LOCKED_REFUNDS_KEY).unwrap_or(0),
        get_balance_for_asset(xel).unwrap_or(0),
        s.load(PAUSED_KEY).unwrap_or(false),
        s.load(TRADING_FEE_KEY).unwrap_or(DEFAULT_TRADING_FEE_BPS),
        s.load(MIGRATED_COUNT_KEY).unwrap_or(0),
        s.load(TOTAL_BUDGETS_KEY).unwrap_or(0),
        s.load(VOTE_POTS_KEY).unwrap_or(0)
    )
}

// 73. Launch parameter set: (submission_fee, asset_budget, min_liquidity,
//     trading_fee_bps, graduated_fee_bps, min_participants,
//     min_approval_ratio_bps, validation_duration, graduation_multiplier,
//     direct_listing_threshold, migration_fee_bps). Recovery, team and
//     vote-deposit parameters live in their own views (get_recovery_config
//     / get_team_config / get_vote_config); the DEX pin lives in
//     get_migration_info.
pub fn get_config() -> (u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(SUBMISSION_FEE_KEY).unwrap_or(DEFAULT_SUBMISSION_FEE),
        s.load(ASSET_BUDGET_KEY).unwrap_or(DEFAULT_ASSET_BUDGET),
        s.load(MIN_LIQUIDITY_KEY).unwrap_or(DEFAULT_MIN_LIQUIDITY),
        s.load(TRADING_FEE_KEY).unwrap_or(DEFAULT_TRADING_FEE_BPS),
        s.load(GRADUATED_FEE_KEY).unwrap_or(DEFAULT_GRADUATED_FEE_BPS),
        s.load(MIN_PARTICIPANTS_KEY).unwrap_or(DEFAULT_MIN_PARTICIPANTS),
        s.load(MIN_APPROVAL_KEY).unwrap_or(DEFAULT_MIN_APPROVAL_BPS),
        s.load(VALIDATION_DURATION_KEY).unwrap_or(DEFAULT_VALIDATION_TOPO),
        s.load(GRAD_MULTIPLIER_KEY).unwrap_or(DEFAULT_GRAD_MULTIPLIER),
        s.load(DIRECT_LISTING_KEY).unwrap_or(DEFAULT_DIRECT_LISTING),
        s.load(MIGRATION_FEE_KEY).unwrap_or(DEFAULT_MIGRATION_FEE_BPS)
    )
}

// 71b. Vote-deposit parameter set (D21): (vote_deposit, locked_vote_pots).
//     vote_deposit is the CURRENT dial (0.5 XEL by default since v4.2;
//     0 = voting is free); pots is the total XEL currently locked as
//     refundable voter deposits — part of the committed side of I2,
//     shown here so the solvency dashboard and the site can display
//     both without extra reads.
pub fn get_vote_config() -> (u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(VOTE_DEPOSIT_KEY).unwrap_or(DEFAULT_VOTE_DEPOSIT),
        s.load(VOTE_POTS_KEY).unwrap_or(0)
    )
}

// 75. Recovery parameter set: (recovery_fee, recovery_min_participants,
//     recovery_min_ratio_bps).
pub fn get_recovery_config() -> (u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(RECOVERY_FEE_KEY).unwrap_or(DEFAULT_RECOVERY_FEE),
        s.load(RECOVERY_PARTICIPANTS_KEY).unwrap_or(DEFAULT_RECOVERY_PARTICIPANTS),
        s.load(RECOVERY_RATIO_KEY).unwrap_or(DEFAULT_RECOVERY_RATIO_BPS)
    )
}

// 76. Team parameter set: (team_unlock_delay, vesting_min, vesting_max),
//     all in topoheights (D3).
pub fn get_team_config() -> (u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(TEAM_DELAY_KEY).unwrap_or(DEFAULT_TEAM_DELAY),
        s.load(VESTING_MIN_KEY).unwrap_or(DEFAULT_VESTING_MIN),
        s.load(VESTING_MAX_KEY).unwrap_or(DEFAULT_VESTING_MAX)
    )
}

// 77. SOCIAL LINKS (D11): (twitter, telegram, discord) — empty string
//     means "no link". Updatable by the creator at any time via
//     update_project_info; the frontend renders, the voters judge.
pub fn get_social_links(pid: u64) -> (string, string, string) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_TWITTER)).unwrap_or(""),
        s.load(proj_key(pid, F_TELEGRAM)).unwrap_or(""),
        s.load(proj_key(pid, F_DISCORD)).unwrap_or("")
    )
}

// 78. TRADING STATS (D12): (buy_volume, sell_volume, total_volume,
//     trade_count, last_trade_topo) — the project's CURVE-ERA scoreboard,
//     maintained by record_trade on every curve buy/sell. buy_volume sums
//     the attached XEL of every buy (fee included); sell_volume sums the
//     pre-fee gross of every sell; total == buy + sell (I9). Post-migration
//     the curve scoreboard freezes — the pool-era stats live on LaunchDEX
//     (get_pool_volume; the SDK composes both eras).
pub fn get_trading_stats(pid: u64) -> (u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_BUY_VOL)).unwrap_or(0),
        s.load(proj_key(pid, F_SELL_VOL)).unwrap_or(0),
        s.load(proj_key(pid, F_VOLUME)).unwrap_or(0),
        s.load(proj_key(pid, F_TRADES)).unwrap_or(0),
        s.load(proj_key(pid, F_LAST_TRADE)).unwrap_or(0)
    )
}

// 79. MARKET CAP HISTORY (D12): (current, all_time_high, at_graduation) —
//     the stored series maintained by update_market_cap / graduate. current
//     is rewritten after every curve trade; all_time_high only ever grows;
//     at_graduation is snapshotted once, after the migration fee. CURVE
//     ERA: current reads 0 once migrated (the curve is closed); the live
//     cap is the DEX pool's (SDK-composed). All in atomic XEL.
pub fn get_market_cap_history(pid: u64) -> (u64, u64, u64) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_MCAP)).unwrap_or(0),
        s.load(proj_key(pid, F_MCAP_HIGH)).unwrap_or(0),
        s.load(proj_key(pid, F_MCAP_GRAD)).unwrap_or(0)
    )
}

// 80. PROPOSAL DATA (D10, D7) — the ONE-CALL voting card: everything the
//     community needs to judge a proposal BEFORE the vote, in one view:
//     (liquidity, total_supply, team_bps, vesting_plan, direct_listed,
//      created_topo, validation_end, asset_budget). vesting_plan == 0 ->
//     the team claims at graduation; any other value is the linear vesting
//     the contract will bind at graduation (the votable commitment).
//     direct_listed is the D7 snapshot: liquidity >= threshold at propose
//     time -> graduates the moment validation passes. asset_budget is the
//     earmarked creation cost (D13 — the unused part is refunded to the
//     creator at creation). Metadata lives in get_project_info /
//     get_social_links; live curve numbers in get_project_tokenomics /
//     get_bonding_info / get_current_price.
pub fn get_proposal_data(pid: u64) -> (u64, u64, u64, u64, bool, u64, u64, u64) {
    let s: Storage = Storage::new()
    require_project(pid)
    return (
        s.load(proj_key(pid, F_LIQUIDITY)).unwrap_or(0),
        s.load(proj_key(pid, F_SUPPLY)).unwrap_or(0),
        s.load(proj_key(pid, F_TEAM_BPS)).unwrap_or(0),
        s.load(proj_key(pid, F_VESTING_PLAN)).unwrap_or(0),
        s.load(proj_key(pid, F_DL)).unwrap_or(false),
        s.load(proj_key(pid, F_CREATED)).unwrap_or(0),
        s.load(proj_key(pid, F_DEADLINE)).unwrap_or(0),
        s.load(proj_key(pid, F_BUDGET)).unwrap_or(0)
    )
}

// 81. PROTOCOL VOLUME STATS (D12): (total_volume, total_buy_volume,
//     total_sell_volume, total_trades) across every project ever launched —
//     the launchpad's CURVE-ERA scoreboard. total == buy + sell (I9). The
//     pool-era volumes live on LaunchDEX (per pool; the SDK composes).
pub fn get_volume_stats() -> (u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(TOTAL_VOLUME_KEY).unwrap_or(0),
        s.load(TOTAL_BUY_VOL_KEY).unwrap_or(0),
        s.load(TOTAL_SELL_VOL_KEY).unwrap_or(0),
        s.load(TOTAL_TRADES_KEY).unwrap_or(0)
    )
}

// 82. ASSET INFO (D13) — the real token's on-chain identity:
//     (created, asset_hash, max_supply, circulating_supply, mintable).
//     created == false while the project is still in validation (no asset
//     yet — the hash reads as zero and the supplies as 0). Once created:
//     max_supply is the FIXED cap (MaxSupplyMode::Fixed at creation — the
//     whole supply was minted to this contract and mintable reads false
//     FOREVER; the frontend can show this as the on-chain proof of the
//     cap); circulating_supply is the chain's own count.
pub fn get_asset_info(pid: u64) -> (bool, Hash, u64, u64, bool) {
    let s: Storage = Storage::new()
    require_project(pid)

    let none_hash: Hash = Hash::zero()
    let asset_hash_opt: optional<Hash> = s.load(proj_key(pid, F_ASSET))
    if asset_hash_opt.is_none() {
        return (false, none_hash, 0u64, 0u64, false)
    }
    let hash: Hash = asset_hash_opt.expect("guarded")

    let max_supply: u64 = 0
    let supply: u64 = 0
    let mintable: bool = false
    let fetched: optional<Asset> = Asset::get_by_hash(hash)
    if fetched.is_some() {
        let asset: Asset = fetched.expect("guarded")
        let ms: optional<u64> = asset.get_max_supply()
        if ms.is_some() {
            max_supply = ms.expect("guarded")
        }
        supply = asset.get_supply()
        mintable = asset.is_mintable()
    }
    return (true, hash, max_supply, supply, mintable)
}

// 79b. REVERSE LOOKUP (D22): the project id that owns a given asset hash.
//     THE DEX->LAUNCHPAD BRIDGE: LaunchDEX enumerates pools by ASSET
//     (get_pools_count / get_pool_by_index); this view maps each pool's
//     asset back to the launchpad project (name, socials, trust, vesting,
//     scoreboard — everything the site shows). Panics ("noasset") on an
//     unknown hash: assets never launched here have no project page.
pub fn get_project_by_asset(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    let pid_opt: optional<u64> = s.load(ASSET_LOOKUP_PREFIX + asset.to_hex())
    require(pid_opt.is_some(), "noasset")
    return pid_opt.expect("guarded")
}

// 84. MIGRATION INFO (D15, D19) — the pool-era bridge:
//     (migrated, migrated_at_topo, xel_sent, tokens_sent, dex_address_hex,
//      dex_trust_synced). migrated == false until migrate() succeeded;
//     then migrated_at is the topoheight of the move and xel/tokens are
//     exactly what seeded the LaunchDEX pool (query the pool itself with
//     the project's asset hash — get_asset_info). dex_address_hex is the
//     pinned DEX contract (empty while unset). dex_trust_synced tells
//     whether the pool's buys-pause mirrors the current trust status
//     (sync_trust_to_dex brings it up to date — D17).
pub fn get_migration_info(pid: u64) -> (bool, u64, u64, u64, string, bool) {
    let s: Storage = Storage::new()
    require_project(pid)

    let dex_hex: string = ""
    let dex_opt: optional<Hash> = s.load(DEX_ADDRESS_KEY)
    if dex_opt.is_some() {
        let dex: Hash = dex_opt.expect("guarded")
        dex_hex = dex.to_hex()
    }

    return (
        s.load(proj_key(pid, F_MIGRATED)).unwrap_or(false),
        s.load(proj_key(pid, F_MIG_AT)).unwrap_or(0),
        s.load(proj_key(pid, F_MIG_XEL)).unwrap_or(0),
        s.load(proj_key(pid, F_MIG_TOK)).unwrap_or(0),
        dex_hex,
        s.load(proj_key(pid, F_DEX_SYNCED)).unwrap_or(false)
    )
}

// 80b. MIGRATED COUNT (D22): how many projects ever moved their liquidity
//      to a DEX pool. The listing pagination bound for get_migrated_by_rank
//      — pair them like the status listings (migrated projects keep their
//      status code; this index cuts across statuses AND DEX generations).
pub fn get_migrated_count() -> u64 {
    return Storage::new().load(MIGRATED_COUNT_KEY).unwrap_or(0)
}

// 80c. Id of the rank-th (0-based, oldest first) MIGRATED project.
//      Sentinel: migrated_count when rank is out of range — the same
//      convention as get_project_by_rank. Every id returned here has
//      get_migration_info(id).migrated == true and a live LaunchDEX pool
//      under its asset hash (get_asset_info).
pub fn get_migrated_by_rank(rank: u64) -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(MIGRATED_COUNT_KEY).unwrap_or(0)
    if rank >= count {
        return count
    }
    return s.load(MIGRATED_INDEX_PREFIX + rank.to_string(10u32)).unwrap_or(count)
}

// 87. Human-readable status label (frontend convenience). The migrated
//     state is a FLAG on top of the status (get_migration_info), not a
//     status code — the launchpad remains the project's home for votes,
//     socials and trust after the move (D15).
pub fn get_status_label(status: u64) -> string {
    if status == ST_VALIDATION {
        return "validation"
    }
    if status == ST_REJECTED {
        return "rejected"
    }
    if status == ST_BONDING {
        return "bonding"
    }
    if status == ST_GRADUATED {
        return "graduated"
    }
    if status == ST_TRUSTED {
        return "trusted"
    }
    if status == ST_UNTRUSTED {
        return "untrusted"
    }
    if status == ST_RECOVERY {
        return "recovery"
    }
    return "unknown"
}

// 88. Contract version.
pub fn get_version() -> string {
    return VERSION
}
