// PrivacyMixer.slx — XELIS Vault v3 (Tornado-style fixed denominations)
//
// ============================================================================
// DESIGN (v3, 2026-09) — "sans intermédiaire", montants jamais stockés
// ============================================================================
// v1 stored sender/recipient/amount per deposit (fatal linkability, removed).
// v2 replaced it with secret notes carrying a PLAINTEXT u64 balance: the
// contract storage itself leaked every note's amount, and distinctive
// amounts could correlate a deposit with its withdrawal.
//
// v3 is the classic Tornado model, which needs NO zero-knowledge proof
// because notes are consumed atomically:
//
//   deposit(asset, secret)
//     - the attached amount must be EXACTLY one of the fixed denominations
//       (1, 10 or 100 units => 1e8 / 1e9 / 1e10 atomic, 8-decimals assets);
//     - the only thing written on-chain is a nullifier-ready commitment:
//         n_<asset>_<class>_<blake3(secret)> = true
//       NO sender, NO recipient, NO amount, NO timestamp, NO pubkey.
//     - funds join the SHARED pool of the asset.
//
//   withdraw(recipient, asset, amount, secret)
//     - `amount` must be exactly one of the fixed denominations;
//     - the commitment is recomputed from the presented secret, the note is
//       consumed (nullified) and the denomination is transferred from the
//       shared pool to ANY address.
//
// WHY THIS IS SOUND WITHOUT ZK:
//   - fixed denominations => all deposits of a class are perfectly fungible;
//     there is no amount-based correlation inside a class;
//   - atomic nullifier consumption => no "remaining balance" arithmetic, so
//     no over-withdraw is possible and no balance proof is needed;
//   - XELIS L1 confidentiality encrypts every transfer amount, so neither
//     the deposit attachment nor the withdrawal transfer is readable;
//   - the withdrawal recipient is arbitrary (a fresh address), and the
//     secret is a bearer instrument transferable off-chain.
//   Anonymity set = every depositor of the same (asset, denomination).
//
// LIMITS (honest): timing/graph analysis by a determined observer remains
// theoretically possible (as on every non-ZK mixer); a same-address reuse
// between deposit and withdraw obviously links the two (use a fresh
// address); the VM exposes no BalanceProof/OwnershipProof yet on this
// network version, so relayed withdrawals (relayer paying gas for you)
// would require handing the secret to the relayer — do NOT do that, call
// withdraw directly from your own wallet.
//
// Chunk layout (identical prefix to v2 — CLI keep deposit=6, withdraw=7):
//   0  constructor          6  deposit           12 get_total_mixes
//   1  when_not_paused      7  withdraw          13 set_withdraw_fee_bps
//   2  only_admin           8  get_pool_info     14 set_admin_fee_bps (no-op)
//   3  only_guardian_or_adm 9  get_note_balance  15 set_admin_fee_addr
//   4  note_key            10  get_pool_balance  16 set_treasury
//   5  pool_key            11  get_total_mixed   17 set_registry ...
// ============================================================================

const VERSION: string = "PrivacyMixer v3"

const ADMIN_KEY: string = "a"
const TIMELOCK_KEY: string = "tl"
const GUARDIAN_KEY: string = "gd"
const PAUSED_KEY: string = "pz"
const REGISTRY_KEY: string = "reg"
const TREASURY_KEY: string = "tr"
const ADMIN_FEE_ADDR_KEY: string = "afa"

// Config (kept for ABI compat; v3 charges no deposit fee — see header)
const WITHDRAW_FEE_BPS_KEY: string = "wfb"
const ADMIN_FEE_BPS_KEY: string = "afb"
const NOTE_COUNT_KEY: string = "nc"

const DEFAULT_WITHDRAW_FEE_BPS: u64 = 0
const DEFAULT_ADMIN_FEE_BPS: u64 = 0

// Fixed denominations (atomic units, 8-decimals assets: 1, 10 and 100 units)
const DENOM_1: u64 = 100000000
const DENOM_2: u64 = 1000000000
const DENOM_3: u64 = 10000000000

// Notes: "n_" + asset_hex + "_" + class + "_" + commitment_hex -> true
// class: 1 = DENOM_1, 2 = DENOM_2, 3 = DENOM_3
const NOTE_PREFIX: string = "n_"
const ASSET_POOL_PREFIX: string = "pool_"

// Airdrop wiring (v12)
const AIRDROP_TRACKER_KEY: string = "atk"

// Emergency
const EMERGENCY_REQUEST_TOPO_KEY: string = "ert"
const EMERGENCY_DELAY_BLOCKS: u64 = 17280

// Stats
const TOTAL_MIXED_PREFIX: string = "tm_"
const TOTAL_MIXES_KEY: string = "tmc"

hook constructor() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    s.store(ADMIN_KEY, caller)
    s.store(GUARDIAN_KEY, caller)
    s.store(PAUSED_KEY, false)
    s.store(WITHDRAW_FEE_BPS_KEY, DEFAULT_WITHDRAW_FEE_BPS)
    s.store(ADMIN_FEE_BPS_KEY, DEFAULT_ADMIN_FEE_BPS)
    s.store(NOTE_COUNT_KEY, 0u64)
    s.store(TOTAL_MIXES_KEY, 0u64)
    return 0
}

fn when_not_paused() {
    let s: Storage = Storage::new()
    let paused: bool = s.load(PAUSED_KEY).unwrap_or(false)
    require(!paused, "paused")
}

fn only_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let admin: Address = s.load(ADMIN_KEY).expect("err")
    if caller == admin { return }
    let tl_opt: optional<Hash> = s.load(TIMELOCK_KEY)
    require(tl_opt.is_some(), "notauth")
    let tl: Hash = tl_opt.expect("err")
    let cc: Hash = get_contract_caller().expect("err")
    require(cc == tl, "notauth")
}

fn only_guardian_or_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let g: Address = s.load(GUARDIAN_KEY).expect("err")
    if caller == g { return }
    only_admin()
}

fn note_key(asset: Hash, class: u8, commitment: Hash) -> string {
    return NOTE_PREFIX + asset.to_hex() + "_" + class.to_string(10u32) + "_" + commitment.to_hex()
}

fn pool_key(asset: Hash) -> string {
    return ASSET_POOL_PREFIX + asset.to_hex()
}

// Map an atomic amount to its denomination class (0 = not a denomination)
fn class_of(amount: u64) -> u8 {
    if amount == DENOM_1 { return 1 }
    if amount == DENOM_2 { return 2 }
    if amount == DENOM_3 { return 3 }
    return 0
}

// ============================================================================
// ENTRY 0 (chunk 6): deposit — create a private note and join the shared pool.
// @caller: any
// @params: asset - Hash of the asset to mix (Hash::zero() for XEL)
// @params: secret - user-chosen random secret (bearer instrument, kept
//                   off-chain; the note commitment is blake3(secret))
// @attached: EXACTLY one of the fixed denominations (1, 10 or 100 units)
// @returns: 0
// @security: when_not_paused; rejects non-denomination amounts and reused
//            commitments. Nothing but the commitment marker is stored.
// ============================================================================
entry deposit(asset: Hash, secret: Hash) -> u64 {
    when_not_paused()
    let s: Storage = Storage::new()

    let dep: u64 = get_deposit_for_asset(asset).expect("err")
    let class: u8 = class_of(dep)
    require(class > 0, "baddenom")

    let commitment: Hash = Hash::blake3(secret.to_bytes())
    let key: string = note_key(asset, class, commitment)
    require(s.load(key).is_none(), "exists")
    s.store(key, true)

    // Credit the shared pool (aggregate only — no per-user data).
    let pk: string = pool_key(asset)
    let cur: u64 = s.load(pk).unwrap_or(0)
    s.store(pk, cur + dep)

    // Stats.
    let nc: u64 = s.load(NOTE_COUNT_KEY).unwrap_or(0)
    s.store(NOTE_COUNT_KEY, nc + 1)
    let tm: u64 = s.load(TOTAL_MIXED_PREFIX + asset.to_hex()).unwrap_or(0)
    s.store(TOTAL_MIXED_PREFIX + asset.to_hex(), tm + dep)

    // v12.0: airdrop LIQ points — 10 per unit mixed (inline, fail-safe)
    let ad_t: optional<Hash> = s.load(AIRDROP_TRACKER_KEY)
    if ad_t.is_some() {
        let ad_h: Hash = ad_t.expect("err")
        if ad_h != Hash::zero() {
            let ad_c: Contract = Contract::new(ad_h).expect("err")
            let ad_u: Address = get_caller().expect("err")
            let _ = ad_c.call(77u16, [ad_u, 5u8, (dep / 100000000) * 10, 600u64], {})
        }
    }

    emit_event(0u64, ["MixerDeposit", commitment.to_hex()])
    return 0
}

// ============================================================================
// ENTRY 1 (chunk 7): withdraw — consume a note (nullifier) and pull the
// denomination from the shared pool to ANY chosen recipient.
// @caller: any holder of the secret (call directly from your own wallet)
// @params: recipient - Address receiving the funds (use a fresh address)
// @params: asset - asset being withdrawn
// @params: amount - EXACT denomination the note was created with
// @params: secret - the secret whose commitment was stored at deposit time
// @returns: 0
// @security: when_not_paused; note must exist (atomically consumed);
//            withdraw fee (default 0) goes to the treasury if configured.
// ============================================================================
entry withdraw(recipient: Address, asset: Hash, amount: u64, secret: Hash) -> u64 {
    when_not_paused()
    let s: Storage = Storage::new()

    let class: u8 = class_of(amount)
    require(class > 0, "baddenom")

    let commitment: Hash = Hash::blake3(secret.to_bytes())
    let key: string = note_key(asset, class, commitment)
    require(s.load(key).is_some(), "notfound")
    s.delete(key)

    // Debit the shared pool (bookkeeping).
    let pk: string = pool_key(asset)
    let pool: u64 = s.load(pk).unwrap_or(0)
    require(pool >= amount, "inspool")
    s.store(pk, pool - amount)

    // Transfer the denomination from the contract's shared balance.
    let withdraw_fee_bps: u64 = s.load(WITHDRAW_FEE_BPS_KEY).unwrap_or(DEFAULT_WITHDRAW_FEE_BPS)
    let withdraw_fee: u64 = (amount * withdraw_fee_bps) / 10000
    let net: u64 = amount - withdraw_fee
    if net > 0 {
        let ok: bool = transfer(recipient, net, asset)
        require(ok, "txfail")
    }

    // Protocol fee to treasury (if configured).
    if withdraw_fee > 0 {
        let treasury_opt: optional<Hash> = s.load(TREASURY_KEY)
        if treasury_opt.is_some() {
            let treasury_hash: Hash = treasury_opt.expect("err")
            let _ = transfer_contract(treasury_hash, withdraw_fee, asset)
        }
    }

    // Stats.
    let tmc: u64 = s.load(TOTAL_MIXES_KEY).unwrap_or(0)
    s.store(TOTAL_MIXES_KEY, tmc + 1)

    emit_event(0u64, ["MixerWithdraw", commitment.to_hex()])
    return 0
}

// ============================================================================
// PUB FN: read-only getters — expose NO per-user data.
// ============================================================================

// (pool balance, notes created, withdraw fee bps, admin fee bps, total mixes)
pub fn get_pool_info(asset: Hash) -> (u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(pool_key(asset)).unwrap_or(0),
        s.load(NOTE_COUNT_KEY).unwrap_or(0),
        s.load(WITHDRAW_FEE_BPS_KEY).unwrap_or(DEFAULT_WITHDRAW_FEE_BPS),
        s.load(ADMIN_FEE_BPS_KEY).unwrap_or(DEFAULT_ADMIN_FEE_BPS),
        s.load(TOTAL_MIXES_KEY).unwrap_or(0)
    )
}

// Remaining value of a note identified by its commitment: the denomination
// if the note is still spendable, 0 once consumed. (Checks the 3 classes.)
pub fn get_note_balance(asset: Hash, commitment: Hash) -> u64 {
    let s: Storage = Storage::new()
    let k1: optional<bool> = s.load(note_key(asset, 1u8, commitment))
    if k1.is_some() { return DENOM_1 }
    let k2: optional<bool> = s.load(note_key(asset, 2u8, commitment))
    if k2.is_some() { return DENOM_2 }
    let k3: optional<bool> = s.load(note_key(asset, 3u8, commitment))
    if k3.is_some() { return DENOM_3 }
    return 0
}

pub fn get_pool_balance(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    return s.load(pool_key(asset)).unwrap_or(0)
}

pub fn get_total_mixed(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    return s.load(TOTAL_MIXED_PREFIX + asset.to_hex()).unwrap_or(0)
}

pub fn get_total_mixes() -> u64 {
    let s: Storage = Storage::new()
    return s.load(TOTAL_MIXES_KEY).unwrap_or(0)
}

// v3: the three fixed denominations, for CLI/tools display.
pub fn get_denominations() -> (u64, u64, u64) {
    return (DENOM_1, DENOM_2, DENOM_3)
}

// ============================================================================
// ADMIN ENTRIES
// ============================================================================

entry set_withdraw_fee_bps(bps: u64) -> u64 {
    only_admin()
    require(bps <= 500, "toohigh")
    Storage::new().store(WITHDRAW_FEE_BPS_KEY, bps)
    return 0
}

// Kept for ABI compatibility — v3 never charges a deposit fee (a fee would
// break the exact-denomination pool accounting). The value is stored but
// ignored by deposit().
entry set_admin_fee_bps(bps: u64) -> u64 {
    only_admin()
    require(bps <= 100, "toohigh")
    Storage::new().store(ADMIN_FEE_BPS_KEY, bps)
    return 0
}

entry set_admin_fee_addr(addr: Address) -> u64 {
    only_admin()
    Storage::new().store(ADMIN_FEE_ADDR_KEY, addr)
    return 0
}

entry set_treasury(tr: Hash) -> u64 {
    only_admin()
    Storage::new().store(TREASURY_KEY, tr)
    return 0
}

entry set_registry(reg: Hash) -> u64 {
    only_admin()
    Storage::new().store(REGISTRY_KEY, reg)
    return 0
}

entry set_timelock(tl: Hash) -> u64 {
    only_admin()
    Storage::new().store(TIMELOCK_KEY, tl)
    return 0
}

entry set_guardian(g: Address) -> u64 {
    only_guardian_or_admin()
    Storage::new().store(GUARDIAN_KEY, g)
    return 0
}

entry pause(reason: string) -> u64 {
    only_guardian_or_admin()
    Storage::new().store(PAUSED_KEY, true)
    emit_event(0u64, ["MixerPaused", reason])
    return 0
}

entry unpause() -> u64 {
    only_guardian_or_admin()
    Storage::new().store(PAUSED_KEY, false)
    return 0
}

entry transfer_admin(new_admin: Address) -> u64 {
    only_admin()
    Storage::new().store(ADMIN_KEY, new_admin)
    return 0
}

entry request_emergency_withdraw() -> u64 {
    only_admin()
    Storage::new().store(EMERGENCY_REQUEST_TOPO_KEY, get_current_topoheight())
    return 0
}

entry execute_emergency_withdraw(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let admin: Address = s.load(ADMIN_KEY).expect("err")
    require(caller == admin, "notauth")
    let req_topo: u64 = s.load(EMERGENCY_REQUEST_TOPO_KEY).unwrap_or(0)
    require(req_topo > 0, "norequest")
    require(get_current_topoheight() >= req_topo + EMERGENCY_DELAY_BLOCKS, "toosoon")
    s.delete(EMERGENCY_REQUEST_TOPO_KEY)
    let bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    if bal > 0 {
        let _ = transfer(caller, bal, asset)
    }
    return 0
}

entry get_version() -> string {
    return VERSION
}

pub fn set_timelock_tl(tl: Hash) -> u64 {
    only_admin()
    Storage::new().store(TIMELOCK_KEY, tl)
    return 0
}

// ============================================================================
// v12.0 — AIRDROP AUTO-RECORDING (APPENDED)
// ============================================================================

// entry: set_airdrop_tracker — point this mixer at the tracker.
// @caller: admin (or timelock as contract caller)
entry set_airdrop_tracker(at: Hash) -> u64 { only_admin() Storage::new().store(AIRDROP_TRACKER_KEY, at) return 0 }

// pub fn: read the configured AirdropTracker hash (deploy checks).
pub fn get_airdrop_tracker() -> Hash {
    return Storage::new().load(AIRDROP_TRACKER_KEY).unwrap_or(Hash::zero())
}
